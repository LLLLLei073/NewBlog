---
/**
 * 「抽屉杂记」全部便签:按时间铺开的便签墙。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OthersNav from '../../components/others/OthersNav.astro';
import PinnedNote from '../../components/others/PinnedNote.astro';
import { postHref } from '../../utils/postRoute.ts';
import { getPostCategory } from '../../utils/categories.ts';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && getPostCategory(p.data).id === 'others')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title="全部便签 · 抽屉杂记"
  description="其他专栏全部文章:项目、建站与随笔,按时间钉在板上。"
  pageName="others"
>
  <div class="others notes-page">
    <OthersNav />

    <header class="page-head o-rise">
      <p class="mono-label">NOTE WALL · {posts.length} 张</p>
      <h1>全部便签</h1>
      <p class="head-note">
        抽屉里的东西全在这块板上,按钉上去的时间从新到旧排列。
      </p>
    </header>

    {
      posts.length > 0 ? (
        <div class="wall o-rise d1">
          {posts.map((p, i) => (
            <PinnedNote
              title={p.data.title}
              desc={p.data.description}
              date={fmtDate(p.data.pubDate)}
              href={postHref(p.id, p.data.category)}
              tone={i}
              index={i}
            />
          ))}
        </div>
      ) : (
        <p class="empty o-rise d1">板还空着,第一张便签等你来钉。</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .notes-page {
    padding-top: clamp(2rem, 5vw, 3.2rem);
    padding-bottom: clamp(3.5rem, 8vw, 5.5rem);
    max-width: 1020px;
  }

  .page-head h1 {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 4vw, 48px);
    color: var(--foreground);
  }
  .head-note {
    margin: 1rem 0 0;
    max-width: 50ch;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--muted-foreground);
  }

  .wall {
    margin-top: 2.4rem;
    padding: 1.2rem;
    border: 1px dashed var(--border-400);
    border-radius: 10px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.8rem 1.4rem;
  }
  .empty {
    margin-top: 2rem;
    padding: 1.4rem 0;
    color: var(--muted-foreground);
    font-size: 14.5px;
  }

  @media (max-width: 480px) {
    .wall {
      grid-template-columns: 1fr;
    }
  }
</style>
