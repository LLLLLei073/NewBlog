---
import BaseLayout from '../layouts/BaseLayout.astro';

// 友情链接：在此处添加朋友（name / desc / url / avatar 可选）
const friends = [
  {
    name: '示例友链',
    desc: '这里放你朋友的博客简介，一行即可。',
    url: 'https://example.com',
    avatar: '',
  },
];
---

<BaseLayout title="友情链接" description="朋友们">
  <section class="container">
    <div class="page-head">
      <p class="eyebrow">友情链接</p>
      <h1>友情链接</h1>
      <p class="lead">交换友链请留言或联系我。</p>
    </div>

    <div class="friend-grid">
      {
        friends.map((f) => (
          <a href={f.url} target="_blank" rel="noopener" class="friend-card">
            <div class="friend-avatar">
              {f.avatar ? (
                <img src={f.avatar} alt="" loading="lazy" />
              ) : (
                <span class="friend-fallback">{f.name.slice(0, 1)}</span>
              )}
            </div>
            <div class="friend-body">
              <h2 class="friend-name">{f.name}</h2>
              <p class="friend-desc">{f.desc}</p>
            </div>
            <span class="friend-arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>

    <p class="friend-empty">共 {friends.length} 位朋友。</p>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 2.5rem 0 1.75rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary);
    margin: 0 0 0.65rem;
  }

  .page-head h1 {
    font-size: 2rem;
    margin: 0 0 0.4rem;
  }

  .lead {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted-foreground);
    margin: 0;
  }

  .friend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
    padding-bottom: 2rem;
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.2s ease, box-shadow 0.15s ease;
  }

  .friend-card:hover {
    border-color: var(--brand-300);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .friend-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-100);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--primary);
  }

  .friend-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .friend-body {
    min-width: 0;
    flex: 1;
  }

  .friend-name {
    font-size: 0.98rem;
    margin: 0 0 0.2rem;
    color: var(--foreground);
  }

  .friend-desc {
    margin: 0;
    font-size: 0.78rem;
    color: var(--muted-foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-arrow {
    color: var(--muted-foreground);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .friend-card:hover .friend-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .friend-empty {
    font-size: 0.85rem;
    color: var(--muted-foreground);
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .page-head {
      padding: 1.75rem 0 1.25rem;
      margin-bottom: 1.5rem;
    }
    .page-head h1 {
      font-size: 1.6rem;
    }
  }
</style>
