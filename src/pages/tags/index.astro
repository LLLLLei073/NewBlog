---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { getAllTags } from '../../utils/tags';

const tags = await getAllTags();
---

<BaseLayout title="标签" description="按标签浏览文章">
  <section class="container">
    <div class="page-head">
      <p class="eyebrow">标签</p>
      <h1>所有标签</h1>
      <p class="lead">共 {tags.length} 个标签，点击标签查看相关文章。</p>
    </div>

    <div class="tag-cloud">
      {tags.map(({ tag, count }) => (
        <div class="tag-item">
          <Tag tag={tag} size="md" />
          <span class="count">{count}</span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--primary);
    margin: 0 0 0.75rem;
  }

  .page-head h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
  }

  .lead {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--muted-foreground);
    margin: 0;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 2rem;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
</style>
