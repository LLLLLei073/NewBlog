---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Tag from '../../components/Tag.astro';
import { getCollection } from 'astro:content';
import { getAllTags } from '../../utils/tags';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的所有文章`}>
  <section class="container">
    <div class="page-head">
      <p class="eyebrow">标签</p>
      <h1>#{tag}</h1>
      <p class="lead">共 {allPosts.length} 篇文章</p>
      <a href="/tags" class="back">&larr; 返回标签云</a>
    </div>

    <div class="post-list">
      {allPosts.map((post) => (
        <a href={`/blog/${post.id}/`} class="post-card">
          <div class="post-meta">
            <FormattedDate date={post.data.pubDate} />
          </div>
          <h2>{post.data.title}</h2>
          <p class="desc">{post.data.description}</p>
          <div class="tags">
            {post.data.tags.map((t) => (
              <Tag tag={t} />
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--primary);
    margin: 0 0 0.75rem;
  }

  .page-head h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
  }

  .lead {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--muted-foreground);
    margin: 0 0 0.75rem;
  }

  .back {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted-foreground);
    transition: color 0.15s ease;
  }

  .back:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
  }

  .post-card {
    display: block;
    padding: 1.5rem;
    background: var(--popover);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-xs);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .post-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-400);
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    margin-bottom: 0.5rem;
  }

  .post-card h2 {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
    color: var(--card-foreground);
  }

  .desc {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
</style>
