---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已经移动。" noindex>
  <section class="notfound container">
    <p class="nf-code">404</p>
    <h1 class="nf-title">页面走丢了</h1>
    <p class="nf-desc">你要找的页面可能已被移动、删除，或者地址有误。</p>
    <div class="nf-actions">
      <a href="/" class="btn primary">返回首页</a>
      <a href="/blog" class="btn secondary">浏览文章</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 1rem 7rem;
  }

  .nf-code {
    font-family: var(--font-display);
    font-size: 5.5rem;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 0.5rem;
    color: var(--primary);
  }

  .nf-title {
    font-size: 1.5rem;
    margin: 0 0 0.6rem;
  }

  .nf-desc {
    font-size: 0.95rem;
    color: var(--muted-foreground);
    margin: 0 0 1.75rem;
  }

  .nf-actions {
    display: flex;
    gap: 0.6rem;
  }

  .btn {
    padding: 0.55rem 1.3rem;
    font-size: 0.88rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .btn:active {
    transform: scale(0.96);
  }

  .btn.primary {
    background: var(--primary);
    color: #fff;
  }

  .btn.primary:hover {
    box-shadow: 0 6px 20px rgba(217, 119, 87, 0.35);
    transform: translateY(-1px);
  }

  .btn.secondary {
    background: transparent;
    color: var(--foreground);
    border: 1px solid var(--border);
  }

  .btn.secondary:hover {
    border-color: var(--brand-300);
    color: var(--primary);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .notfound {
      padding: 4rem 1rem 5rem;
    }
    .nf-code {
      font-size: 4rem;
    }
  }
</style>
