---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostSearch from '../../components/PostSearch.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="文章" description="所有博客文章">
  <section class="container">
    <div class="page-head">
      <p class="eyebrow">文章</p>
      <h1>所有文章</h1>
      <p class="lead">共 {posts.length} 篇文章，记录技术与生活的思考。</p>
    </div>
    <PostSearch total={posts.length} placeholder="搜索全部文章..." />
    <div class="post-list">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="post-card"
            data-search-item
            data-title={post.data.title}
            data-desc={post.data.description}
          >
            <div class="post-meta">
              <FormattedDate date={post.data.pubDate} />
              {post.data.category && <span class="post-cat">{post.data.category}</span>}
            </div>
            <h2 data-search-text="title">{post.data.title}</h2>
            <p class="desc" data-search-text="desc">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 2.5rem 0 1.75rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary);
    margin: 0 0 0.65rem;
  }

  .page-head h1 {
    font-size: 2rem;
    margin: 0 0 0.4rem;
  }

  .lead {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted-foreground);
    margin: 0;
  }

  .post-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    padding-bottom: 2rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.2s ease;
  }

  .post-card:hover {
    text-decoration: none;
    border-color: var(--brand-300);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
    margin-bottom: 0.4rem;
  }

  .post-cat {
    padding: 0.08rem 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
    background: var(--brand-100);
    border-radius: var(--radius-full);
  }

  .post-card h2 {
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
    color: var(--card-foreground);
  }

  .desc {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .page-head {
      padding: 1.75rem 0 1.25rem;
      margin-bottom: 1rem;
    }
    .page-head h1 {
      font-size: 1.6rem;
    }
    .post-list {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding-bottom: 1.5rem;
    }
    .post-card {
      padding: 1rem;
    }
    .post-card h2 {
      font-size: 1.05rem;
    }
  }
</style>
