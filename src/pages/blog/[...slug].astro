---
/**
 * /blog/<slug>/ 现在是所有文章旧地址的迁移桩:五个专栏
 * (algorithm/music/math/game/others)文章均已迁入 /<column>/notes/<slug>/,
 * 这里统一生成 meta refresh + canonical,保住历史外链与 SEO。
 * /blog/ 索引仍保留为全站文章总目录。
 */
import { type CollectionEntry, getCollection } from 'astro:content';
import {
  SITE_AUTHOR,
  SITE_AUTHOR_IMAGE,
  SITE_TITLE,
  SITE_URL,
} from '../../consts.ts';
import { postHref } from '../../utils/postRoute.ts';
import { getPostCategory } from '../../utils/categories.ts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, redirect: postHref(post.id, post.data.category) },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  redirect: string;
}

const { post, redirect } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
const canonicalUrl = new URL(redirect, Astro.site ?? SITE_URL).toString();
const categoryLabel = getPostCategory(post.data).label;

// Article 结构化数据(SEO):与专栏新页面保持同一份规则,中文栏目名
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: SITE_AUTHOR,
    url: SITE_URL,
    image: new URL(SITE_AUTHOR_IMAGE, SITE_URL).toString(),
  },
  publisher: { '@type': 'Person', name: SITE_AUTHOR, url: SITE_URL },
  articleSection: categoryLabel,
  mainEntityOfPage: canonicalUrl,
  ...(heroImage ? { image: new URL(heroImage, SITE_URL).toString() } : {}),
};
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} | ${SITE_TITLE}`}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta http-equiv="refresh" content={`0; url=${redirect}`} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <p>
      本文已迁移到 <a href={redirect}>新地址</a>,正在跳转……
    </p>
  </body>
</html>
