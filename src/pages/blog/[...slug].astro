---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { SITE_AUTHOR, SITE_AUTHOR_IMAGE, SITE_URL } from '../../consts.ts';

type Nav = { slug: string; title: string };
type Related = { slug: string; title: string; description: string; pubDate: Date; category: string | null };
type SeriesPost = { slug: string; title: string };

export async function getStaticPaths() {
  const allPosts = (await getCollection('blog'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return allPosts.map((post, i) => {
    const newer = i > 0 ? allPosts[i - 1] : null;
    const older = i < allPosts.length - 1 ? allPosts[i + 1] : null;

    // 同系列文章（按发布日期排序）
    const seriesPosts = post.data.series
      ? allPosts
          .filter((p) => p.id !== post.id && p.data.series === post.data.series)
          .map((p) => ({ slug: p.id, title: p.data.title } as SeriesPost))
      : [];

    // 推荐阅读：先同专栏近邻 3 篇，不够用最近的其他文章补齐
    const sameCat = allPosts.filter(
      (p) => p.id !== post.id && (p.data.category ?? null) === (post.data.category ?? null)
    );
    const otherCat = allPosts.filter(
      (p) => p.id !== post.id && (p.data.category ?? null) !== (post.data.category ?? null)
    );
    const related = [...sameCat, ...otherCat].slice(0, 3).map(
      (p) =>
        ({
          slug: p.id,
          title: p.data.title,
          description: p.data.description,
          pubDate: p.data.pubDate,
          category: p.data.category ?? null,
        } as Related)
    );

    return {
      params: { slug: post.id },
      props: {
        post,
        newer: newer ? ({ slug: newer.id, title: newer.data.title } as Nav) : null,
        older: older ? ({ slug: older.id, title: older.data.title } as Nav) : null,
        related,
        seriesPosts,
        seriesName: post.data.series ?? null,
      },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  newer: Nav | null;
  older: Nav | null;
  related: Related[];
  seriesPosts: SeriesPost[];
  seriesName: string | null;
}

const { post, newer, older, related, seriesPosts, seriesName } = Astro.props;
const { Content, headings } = await render(post);
const rawBody = typeof post.body === 'string' ? post.body : '';
const { title, description, pubDate, updatedDate, heroImage, category } = post.data;

// Article 结构化数据（SEO）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: SITE_AUTHOR,
    url: SITE_URL,
    image: new URL(SITE_AUTHOR_IMAGE, SITE_URL).toString(),
  },
  publisher: { '@type': 'Person', name: SITE_AUTHOR, url: SITE_URL },
  ...(category ? { articleSection: category } : {}),
  mainEntityOfPage: `${SITE_URL}/blog/${post.id}/`,
  ...(heroImage ? { image: new URL(heroImage, SITE_URL).toString() } : {}),
};
---

<BlogPost {...post.data} headings={headings} newer={newer} older={older} related={related} rawBody={rawBody} seriesPosts={seriesPosts} seriesName={seriesName}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Content />
</BlogPost>
