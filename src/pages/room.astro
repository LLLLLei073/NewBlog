---
import BaseLayout from '../layouts/BaseLayout.astro';
import Room from '../components/room/Room.astro';
---

<BaseLayout
  immersiveHome
  title="小房间"
  description="窗边的书房，少女在读书，小煤球偶尔路过。"
>
  <section class="room-ending" aria-labelledby="room-ending-title">
    <header class="room-ending-head">
      <a href="/">← 回到窗边</a>
      <div>
        <h1 id="room-ending-title">还是这间书房。</h1><p>
          读一会儿书，也发一会儿呆。
        </p>
      </div>
    </header>
    <Room />
  </section>
</BaseLayout>
<style is:global>
  body[data-room-home] {
    --background: #182320;
    --foreground: #ece8dc;
    --muted-foreground: #bbc4b9;
    --card: #23312d;
    --border: #536057;
    --primary: #d0d5b4;
    --room-paper: #182320;
    --room-ink: #ece8dc;
    --room-muted: #bbc4b9;
    background: #182320 !important;
    color: #ece8dc;
  }
  body[data-room-home]::before,
  body[data-room-home]::after {
    display: none !important;
  }
  .room-ending {
    width: min(1280px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }
  .room-ending-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin: 0 0 24px;
  }
  .room-ending-head > a {
    font-size: 12px;
    color: #c9d0bd;
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .room-ending-head h1 {
    color: #ece8dc;
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    margin: 0;
  }
  body[data-room-home] header.immersive {
    background: #182320;
    border-color: #536057;
  }
  body[data-room-home] header.immersive .brand {
    color: #ece8dc;
  }
  .room-ending-head p {
    margin: 0.5rem 0 0;
    color: #bbc4b9;
    font-size: 12px;
  }
  @media (max-width: 700px) {
    .room-ending {
      width: calc(100% - 24px);
      padding-top: 0;
    }
    .room-ending-head {
      align-items: start;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 18px;
    }
  }
</style>
