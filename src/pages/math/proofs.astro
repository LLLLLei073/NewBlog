---
/**
 * 「数学观象台」证明画廊:全宽横向条目陈列定理与证明方法,
 * 顶部文字型筛选(直接/反证/归纳/构造/几何);无 JS 时全量显示。
 */
import katex from 'katex';
import 'katex/dist/katex.min.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MathSymbolRail from '../../components/math/MathSymbolRail.astro';
import MathFigure from '../../components/math/MathFigure.astro';
import { COLUMN, PROOF_METHODS, PROOFS } from '../../data/math/column.ts';

const texDisplay = (s: string) =>
  katex.renderToString(s, { throwOnError: false, displayMode: true });
const formulas = PROOFS.map((p) => texDisplay(p.formula));
---

<BaseLayout
  title="证明画廊 · 数学观象台"
  description={`数学观象台证明画廊:以不同证明方法收藏定理——${COLUMN.claim}。`}
  pageName="math"
>
  <div class="math gallery-page" data-gallery>
    <MathSymbolRail />

    <header class="page-head m-rise">
      <p class="mono-label kick">∞ PROOF GALLERY</p>
      <h1>证明画廊</h1>
      <p class="head-note">
        每一件定理都值得反复观看:同一条定理,不同的证法是不同的展签。
        {COLUMN.hint}
      </p>
    </header>

    <div class="gm-bar m-rise d1">
      <div class="gm-filters" role="group" aria-label="按证明方法筛选">
        {
          PROOF_METHODS.map((m, i) => (
            <button
              type="button"
              class="ghost-btn gm-btn"
              data-gm-btn={m.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {m.label}
            </button>
          ))
        }
      </div>
      <span class="mono-label gm-count-row">
        当前陈列 <span class="mono-num" data-gm-count>{PROOFS.length} 条</span>
      </span>
    </div>

    <div class="proof-list m-rise d1">
      {
        PROOFS.map((p, i) => (
          <article
            class="proof-row"
            id={p.id}
            data-gm-item={p.method}
          >
            <span class="pr-diagram" aria-hidden="true">
              <MathFigure kind={p.diagram} />
            </span>
            <div class="pr-main">
              <p class="pr-head">
                <span class="obs-no">{p.no}</span>
                <span class="pr-name">{p.name}</span>
                <span class="pr-tag">{p.methodLabel}</span>
                <span class="mono-label">约 {p.minutes} 分钟</span>
              </p>
              <div class="pr-formula formula-scroll">
                <span set:html={formulas[i]} />
              </div>
              <p class="pr-note">{p.note}</p>
              {p.href && (
                <a class="pr-link" href={p.href}>
                  观看完整展品 →
                </a>
              )}
            </div>
          </article>
        ))
      }
      <p class="gm-empty" data-gm-empty hidden>
        这一方法的展品还在整理中,先看看其他展签。
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import { onPageLoad } from '../../utils/lifecycle';

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-gallery]');
    if (!root) return;
    /* 无 dataset 守卫:onPageLoad 两轮触发之间会先执行上一轮清理。 */

    const btns = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-gm-btn]'),
    );
    const items = Array.from(
      root.querySelectorAll<HTMLElement>('[data-gm-item]'),
    );
    const count = root.querySelector<HTMLElement>('[data-gm-count]');
    const empty = root.querySelector<HTMLElement>('[data-gm-empty]');
    let method = 'all';

    const apply = () => {
      let visible = 0;
      items.forEach((el) => {
        const show = method === 'all' || el.dataset.gmItem === method;
        el.hidden = !show;
        if (show) visible++;
      });
      if (count) count.textContent = `${visible} 条`;
      if (empty) empty.hidden = visible > 0;
    };
    const onBtn = (e: MouseEvent) => {
      const b = e.currentTarget as HTMLButtonElement;
      method = b.dataset.gmBtn ?? 'all';
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    };
    btns.forEach((b) => b.addEventListener('click', onBtn));
    apply();

    return () => btns.forEach((b) => b.removeEventListener('click', onBtn));
  });
</script>

<style>
  .gallery-page {
    padding-top: clamp(1.6rem, 4vw, 2.8rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .kick {
    color: var(--primary);
  }
  .page-head h1 {
    margin: 0.8rem 0 0;
    font-family: var(--font-hei);
    font-weight: 300;
    font-size: clamp(34px, 4.4vw, 52px);
    letter-spacing: 0.1em;
    color: var(--foreground);
  }
  .head-note {
    margin: 1rem 0 0;
    max-width: 56ch;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--muted-foreground);
  }

  .gm-bar {
    display: flex;
    align-items: center;
    gap: 1rem 1.6rem;
    flex-wrap: wrap;
    margin-top: 1.8rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--math-divider);
  }
  .gm-filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .gm-count-row {
    margin-left: auto;
  }

  .proof-list {
    scroll-margin-top: calc(var(--header-height, 56px) + 1.5rem);
  }
  .proof-row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 1.4rem;
    padding: 1.6rem 0.3rem;
    border-bottom: 1px solid var(--math-divider);
  }
  .proof-row[hidden] {
    display: none;
  }
  .pr-diagram {
    width: 112px;
    padding-top: 0.2rem;
  }
  .pr-diagram :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .pr-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin: 0;
  }
  .pr-name {
    font-family: var(--font-hei);
    font-weight: 300;
    font-size: 20px;
    letter-spacing: 0.05em;
    color: var(--foreground);
  }
  .pr-tag {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--math-coral);
    border: 1px solid color-mix(in srgb, var(--math-coral) 55%, transparent);
    padding: 0.15em 0.6em;
  }
  .pr-head .mono-label {
    font-size: 10.5px;
  }
  .pr-formula {
    margin-top: 0.7rem;
    color: var(--foreground);
  }
  .pr-formula :global(.katex-display) {
    margin: 0.2rem 0;
    text-align: left;
  }
  .pr-formula :global(.katex) {
    font-size: 1.25em;
  }
  .pr-note {
    margin: 0.6rem 0 0;
    max-width: 68ch;
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted-foreground);
  }
  .pr-link {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--primary);
    text-decoration: none;
    font-size: 13.5px;
    letter-spacing: 0.08em;
    padding: 0.4rem 0;
  }
  .pr-link:hover {
    text-decoration: underline;
  }
  .gm-empty {
    margin: 1.6rem 0;
    color: var(--muted-foreground);
    font-size: 14.5px;
  }

  @media (max-width: 640px) {
    .proof-row {
      grid-template-columns: 1fr;
    }
    .pr-diagram {
      width: 96px;
    }
  }
</style>
