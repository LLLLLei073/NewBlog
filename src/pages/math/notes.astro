---
/**
 * 「数学观象台」数学文章列表:全宽行式索引,顶部置顶展品
 * (欧拉公式展示页),PostSearch 实时过滤(data-search-item)。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MathSymbolRail from '../../components/math/MathSymbolRail.astro';
import PostSearch from '../../components/PostSearch.astro';
import { postHref } from '../../utils/postRoute.ts';
import { readingTime } from '../../utils/reading.ts';
import { COLUMN } from '../../data/math/column.ts';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.category === 'math')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const minutes = (body: string) => readingTime(body ?? '');

/* 手工置顶的展品页与集合文章统一编号 */
const TOTAL = posts.length + 1;
const noOf = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout
  title="数学文章 · 数学观象台"
  description={`数学观象台文章索引:概念可视化、定理证明手记与几何直觉——${COLUMN.claim}。`}
  pageName="math"
>
  <div class="math notes-page">
    <MathSymbolRail />

    <header class="page-head m-rise">
      <p class="mono-label kick">π MATH ARTICLES · {TOTAL} 篇</p>
      <h1>数学文章</h1>
      <p class="head-note">
        每篇文章都是一件展品:先看见结构,再读证明,公式随图形一起生长。
      </p>
    </header>

    <div class="search-anchor m-rise d1" id="search">
      <PostSearch total={TOTAL} placeholder="搜索数学文章…" />
    </div>

    <ol class="article-list m-rise d1">
      {/* 置顶展品:欧拉公式展示页 */}
      <li>
        <a
          href="/math/notes/euler-formula/"
          class="article-row is-featured"
          data-search-item
          data-title="从单位圆理解欧拉公式"
          data-desc="CHAPTER 02 复数 单位圆 旋转 投影 欧拉公式 复平面"
        >
          <span class="a-no">02</span>
          <span class="a-main">
            <span class="a-chapter mono-label">
              CHAPTER 02 / COMPLEX NUMBERS · 展品
            </span>
            <strong>从单位圆理解欧拉公式</strong>
            <span class="a-desc">
              当旋转成为语言,指数便写下了最优雅的诗:单位圆上的 θ,
              如何抵达 e^(iπ) + 1 = 0。
            </span>
          </span>
          <span class="a-side">
            <span class="mono-num">约 9 分钟</span>
            <span class="a-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
      {
        posts.map((p, i) => (
          <li>
            <a
              href={postHref(p.id, p.data.category)}
              class="article-row"
              data-search-item
              data-title={p.data.title}
              data-desc={p.data.description}
            >
              <span class="a-no">{noOf(i + 1)}</span>
              <span class="a-main">
                <strong>{p.data.title}</strong>
                <span class="a-desc">{p.data.description}</span>
              </span>
              <span class="a-side">
                <span class="mono-num">
                  {fmtDate(p.data.pubDate)} · 约 {minutes(p.body ?? '')} 分钟
                </span>
                <span class="a-arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .notes-page {
    padding-top: clamp(1.6rem, 4vw, 2.8rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    max-width: 1020px;
  }
  .kick {
    color: var(--primary);
  }
  .page-head h1 {
    margin: 0.8rem 0 0;
    font-family: var(--font-hei);
    font-weight: 300;
    font-size: clamp(34px, 4.4vw, 50px);
    letter-spacing: 0.1em;
    color: var(--foreground);
  }
  .head-note {
    margin: 1rem 0 0;
    max-width: 52ch;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--muted-foreground);
  }
  .search-anchor {
    scroll-margin-top: calc(var(--header-height, 56px) + 4.2rem);
  }

  .article-list {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--math-divider);
  }
  .article-row {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: start;
    padding: 1.3rem 0.5rem;
    border-bottom: 1px solid var(--math-divider);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .article-row:hover {
    background: var(--accent);
  }
  .a-no {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 20px;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    padding-top: 0.15rem;
  }
  .article-row:hover .a-no {
    color: var(--primary);
  }
  .a-main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .a-chapter {
    color: var(--primary);
  }
  .a-main strong {
    font-family: var(--font-hei);
    font-weight: 400;
    font-size: 18px;
    letter-spacing: 0.03em;
    color: var(--foreground);
  }
  .a-desc {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--muted-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .a-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    font-size: 12px;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  .a-arrow {
    color: var(--primary);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .article-row:hover .a-arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 640px) {
    .article-row {
      grid-template-columns: 2.4rem minmax(0, 1fr);
    }
    .a-side {
      grid-column: 2;
      flex-direction: row;
      align-items: center;
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .a-arrow {
      transition: none;
    }
  }
</style>
