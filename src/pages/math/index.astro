---
/**
 * 「数学观象台 · MATH OBSERVATORY」专栏首页:
 * 近全视口首屏(细字重标题 + 环面线框)→ 底部横向展览索引。
 * 左侧符号栏 + 开屏动画由组件自带;仅在首页挂载开屏。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MathSymbolRail from '../../components/math/MathSymbolRail.astro';
import MathHero from '../../components/math/MathHero.astro';
import ExhibitionIndex from '../../components/math/ExhibitionIndex.astro';
import MathIntro from '../../components/intro/MathIntro.astro';
import { COLUMN } from '../../data/math/column.ts';
---

<BaseLayout
  title="数学观象台 · MATH OBSERVATORY"
  description={COLUMN.intro}
  pageName="math"
>
  <div class="math math-page">
    <MathSymbolRail />
    <MathIntro />
    <MathHero />
    <ExhibitionIndex />
    <footer class="page-end">
      <span class="mono-label">
        {COLUMN.en} · {COLUMN.hint}
      </span>
      <nav class="end-links" aria-label="更多展览入口">
        <a href="/math/proofs/">证明画廊 ∞</a>
        <a href="/math/questions/">问题本 ?</a>
      </nav>
    </footer>
  </div>
</BaseLayout>

<style>
  .math-page {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-height, 56px));
    padding-bottom: 1.2rem;
  }
  .page-end {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 1.2rem;
    border-top: 1px solid var(--math-divider);
  }
  .end-links {
    display: flex;
    gap: 1.4rem;
  }
  .end-links a {
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 13.5px;
    letter-spacing: 0.08em;
    padding: 0.4rem 0;
  }
  .end-links a:hover {
    color: var(--primary);
  }
</style>
