<script>
  import { onPageLoad } from '../../utils/lifecycle';

  onPageLoad(() => {
    const page = document.querySelector<HTMLElement>('.playing-page');
    if (!page) return;
    const chips = Array.from(
      page.querySelectorAll<HTMLButtonElement>('[data-filter]'),
    );
    const cards = Array.from(
      page.querySelectorAll<HTMLElement>('[data-status]'),
    );
    const emptyTip = page.querySelector<HTMLElement>('[data-filter-empty]');
    if (!chips.length || !cards.length) return;
    const apply = (key: string) => {
      let visible = 0;
      cards.forEach((card) => {
        const show = key === 'all' || card.dataset.status === key;
        card.hidden = !show;
        if (show) visible++;
      });
      if (emptyTip) emptyTip.hidden = visible > 0;
      chips.forEach((chip) => {
        const on = chip.dataset.filter === key;
        chip.classList.toggle('active', on);
        chip.setAttribute('aria-pressed', String(on));
      });
    };
    const onClick = (e: MouseEvent) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-filter]',
      );
      if (chip) apply(chip.dataset.filter ?? 'all');
    };
    page.querySelector('.filters')?.addEventListener('click', onClick);
    return () => {
      page.querySelector('.filters')?.removeEventListener('click', onClick);
    };
  });
</script>
