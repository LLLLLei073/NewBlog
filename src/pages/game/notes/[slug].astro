---
/**
 * 「存档之外」手记文章详情:专属命名空间 /game/notes/<slug>/。
 * 正文来自 blog 内容集合(category: game),专属元数据(所属
 * 游戏、WORLD LOG、剧透策略、章节时间轴)来自 data/game/articles,
 * 布局为录像回放 + 杂志剪报(GamePost)。
 */
import { render } from 'astro:content';
import GamePost from '../../../layouts/GamePost.astro';
import {
  getNotePaths,
  type NoteProps,
} from '../../../utils/notes-paths.ts';
import { getGameArticleMeta } from '../../../data/game/articles.ts';

export const getStaticPaths = () => getNotePaths('game');

const { post, newer, older, related } = Astro.props as NoteProps;
const { Content } = await render(post);
const meta = getGameArticleMeta(post.id);
---

<GamePost post={post} meta={meta} newer={newer} older={older} related={related}>
  <Content />
</GamePost>
