---
/**
 * 「存档之外 · BEYOND THE SAVE FILE」专栏首页:
 * 印刷封面拼贴首屏(标题 + 主视觉)→ 三个记忆卡存档槽 →
 * 珊瑚色动态信息条 → 最新手记。首屏主推《我的世界》机械动力
 * 整合包;开屏动画仅在本页挂载(会话一次)。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameNav from '../../components/game/GameNav.astro';
import GameIntro from '../../components/intro/GameIntro.astro';
import GameMasthead from '../../components/game/GameMasthead.astro';
import GameHero from '../../components/game/GameHero.astro';
import SaveSlot from '../../components/game/SaveSlot.astro';
import NowPlayingTicker from '../../components/game/NowPlayingTicker.astro';
import type { TickerItem } from '../../components/game/NowPlayingTicker.astro';
import PixelIcon from '../../components/game/PixelIcon.astro';
import { COLUMN } from '../../data/game/column.ts';
import { GAMES } from '../../data/game/games.ts';
import { getGameArticleMeta } from '../../data/game/articles.ts';
import { postHref } from '../../utils/postRoute.ts';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.category === 'game')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmtDate = (d: Date) =>
  `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(
    d.getDate(),
  ).padStart(2, '0')}`;

/* 每款游戏最近一次记录 = 它最新一篇手记的发布日期(无手记则空缺) */
const latestByGame = new Map<string, (typeof posts)[number]>();
for (const p of posts) {
  const meta = getGameArticleMeta(p.id);
  if (meta?.game && !latestByGame.has(meta.game)) {
    latestByGame.set(meta.game, p);
  }
}
const dateOf = (slug: string) => {
  const p = latestByGame.get(slug);
  return p ? fmtDate(p.data.pubDate) : null;
};
const articleOf = (slug: string) => {
  const p = latestByGame.get(slug);
  return p ? postHref(p.id, p.data.category) : null;
};

const mc = GAMES[0]!;
const mcArticle = articleOf(mc.slug);
const updated = posts[0]
  ? fmtDate(posts[0]!.data.pubDate)
  : fmtDate(new Date());

const recent = posts.slice(0, 5);

const ticker: TickerItem[] = [
  {
    icon: 'gear',
    label: '持续建造',
    text: '《我的世界》机械动力整合包',
    href: `/game/playing/#${mc.slug}`,
  },
  {
    icon: 'leaf',
    label: '最近生存记录',
    text: '《绿色地狱》',
    href: '/game/playing/#green-hell',
  },
  {
    icon: 'chat',
    label: '最新游戏手记',
    text: posts[0]?.data.title ?? '整理中',
    href: posts[0] ? postHref(posts[0].id, posts[0].data.category) : undefined,
  },
  {
    icon: 'star',
    label: '当前收藏',
    text: `${GAMES.length} 款作品`,
    href: '/game/collection/',
  },
];

const slotEntries: Record<
  string,
  { label: string; href: string | null }[]
> = {
  'minecraft-create': [
    { label: '阅读建造手记', href: mcArticle },
    { label: '世界档案', href: `/game/playing/#minecraft-create` },
  ],
  'green-hell': [
    { label: '生存记录', href: `/game/playing/#green-hell` },
    { label: '手记整理中', href: null },
  ],
  'no-game-series': [
    { label: '系列入口', href: `/game/playing/#no-game-series` },
    { label: '手记整理中', href: null },
  ],
};
---

<BaseLayout
  title={`存档之外 · ${COLUMN.en}`}
  description={COLUMN.intro}
  pageName="game"
>
  <div class="gg-wrap game-page">
    <GameNav />
    <GameIntro />

    <GameMasthead updated={updated} />

    <GameHero articleHref={mcArticle} date={dateOf('minecraft-create')} />

    <!-- ===== 三个记忆卡存档槽 ===== -->
    <section class="slots" aria-label="记忆卡存档槽">
      <header class="gg-sec gg-rise">
        <h2>记忆卡存档槽</h2>
        <span class="gg-sec-en">MEMORY CARD SLOTS</span>
        <a class="gg-sec-more" href="/game/playing/">进入正在游玩 →</a>
      </header>
      <div class="slots-grid">
        {
          GAMES.map((game, i) => (
            <div class:list={['gg-rise', `d${(i % 3) + 1}`]}>
              <SaveSlot
                game={game}
                date={dateOf(game.slug)}
                entries={slotEntries[game.slug] ?? []}
              />
            </div>
          ))
        }
      </div>
    </section>

    <div class="gg-rise d1">
      <NowPlayingTicker items={ticker} />
    </div>

    <!-- ===== 最新手记 ===== -->
    <section class="recent" aria-label="最新游戏手记">
      <header class="gg-sec gg-rise">
        <h2>最新手记</h2>
        <span class="gg-sec-en">LATEST NOTES · {posts.length} 篇</span>
        {
          posts.length > 0 && (
            <a class="gg-sec-more" href="/game/notes/">
              全部手记 →
            </a>
          )
        }
      </header>
      {
        recent.length > 0 ? (
          <ul class="recent-list gg-rise d1">
            {recent.map((p) => {
              const meta = getGameArticleMeta(p.id);
              const game = meta?.game ?? null;
              return (
                <li>
                  <a
                    href={postHref(p.id, p.data.category)}
                    class="recent-row"
                  >
                    <PixelIcon
                      name={game === 'green-hell' ? 'leaf' : game === 'no-game-series' ? 'chat' : 'gear'}
                      size={15}
                    />
                    <span class="r-main">
                      <strong>{p.data.title}</strong>
                      <span class="r-desc">{p.data.description}</span>
                    </span>
                    <span class="r-date">{fmtDate(p.data.pubDate)}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="gg-empty">
            <strong>手记存档为空</strong>第一篇手记正在路上。
          </p>
        )
      }
    </section>

    <footer class="page-end">
      <span class="mono-label">{COLUMN.en} · {COLUMN.sticker}</span>
      <nav class="end-links" aria-label="更多栏目入口">
        <a href="/game/playing/">正在游玩</a>
        <a href="/game/collection/">收藏架</a>
        <a href="/game/review/">年度回顾</a>
      </nav>
    </footer>
  </div>
</BaseLayout>

<style>
  .game-page {
    padding-bottom: clamp(2.4rem, 6vw, 4rem);
  }

  .slots {
    padding: clamp(1.6rem, 4vw, 2.6rem) 0 clamp(1.6rem, 4vw, 2.4rem);
  }
  .slots-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
  }
  @media (max-width: 980px) {
    .slots-grid {
      grid-template-columns: 1fr;
      max-width: 560px;
    }
  }

  .recent {
    padding: clamp(1.8rem, 4vw, 2.8rem) 0 0.6rem;
  }
  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--gg-ink);
  }
  .recent-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0.5rem;
    border-bottom: 2px solid rgba(244, 239, 216, 0.3);
    color: var(--gg-cream);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .recent-row:hover {
    background: rgba(244, 239, 216, 0.1);
  }
  .recent-row :global(.px-icon) {
    color: var(--gg-acid);
    align-self: center;
  }
  .r-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .r-main strong {
    font-family: var(--g-disp);
    font-weight: 800;
    font-size: 16.5px;
    line-height: 1.5;
  }
  .r-desc {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--gg-cream-dim);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .r-date {
    font-family: var(--g-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--gg-cream-dim);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 640px) {
    .recent-row {
      grid-template-columns: auto 1fr;
    }
    .r-date {
      display: none;
    }
  }

  .page-end {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: clamp(1.8rem, 4vw, 2.6rem);
    padding-top: 1.1rem;
    border-top: 3px solid var(--gg-ink);
  }
  .page-end .mono-label {
    color: var(--gg-cream-dim);
  }
  .end-links {
    display: flex;
    gap: 1.3rem;
  }
  .end-links a {
    color: var(--gg-cream);
    text-decoration: none;
    font-family: var(--g-disp);
    font-weight: 700;
    font-size: 14px;
    padding: 0.3rem 0;
  }
  .end-links a:hover {
    color: var(--gg-acid);
  }
</style>
