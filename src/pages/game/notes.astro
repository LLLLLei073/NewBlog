---
/**
 * 「游戏手记 · NOTES」:杂志目录式手记索引。
 * 每篇手记一张奶油白剪报卡:所属游戏、章节类型、剧透标识、
 * 摘要与记录日期。剧透标识始终以文字出现,不只靠颜色。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameNav from '../../components/game/GameNav.astro';
import PixelIcon from '../../components/game/PixelIcon.astro';
import { COLUMN } from '../../data/game/column.ts';
import { GAME_BY_SLUG } from '../../data/game/games.ts';
import {
  SPOILER_LABEL,
  getGameArticleMeta,
} from '../../data/game/articles.ts';
import { postHref } from '../../utils/postRoute.ts';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.category === 'game')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmtDate = (d: Date) =>
  `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(
    d.getDate(),
  ).padStart(2, '0')}`;
---

<BaseLayout
  title={`游戏手记 · ${COLUMN.name}`}
  description="存档之外的游戏手记:建造记录、生存经历与仍然记得的桥段。"
  pageName="game"
>
  <div class="gg-wrap notes-page">
    <GameNav />

    <header class="page-head">
      <p class="head-en mono-label">NOTES · {posts.length} 篇</p>
      <h1>游戏手记</h1>
      <p class="head-note">
        每一篇都是一段回放:通关以后仍留在心里的场景、机制与建造过程。
      </p>
    </header>

    {
      posts.length > 0 ? (
        <ul class="clip-list">
          {posts.map((p, i) => {
            const meta = getGameArticleMeta(p.id);
            const game = meta?.game ? GAME_BY_SLUG[meta.game] : null;
            const icon =
              meta?.game === 'green-hell'
                ? 'leaf'
                : meta?.game === 'no-game-series'
                  ? 'chat'
                  : 'gear';
            return (
              <li
                class:list={['gg-card', 'clip', { 'clip--tilt': i % 2 === 1 }]}
              >
                <a href={postHref(p.id, p.data.category)} class="clip-row">
                  <div class="clip-main">
                    <p class="clip-tags">
                      <span class="gg-chip gg-chip--ink">
                        <PixelIcon name={icon} size={12} />
                        {game?.title ?? '专栏手记'}
                      </span>
                      {meta?.chapterTag && (
                        <span class="gg-chip">{meta.chapterTag}</span>
                      )}
                      {meta && (
                        <span
                          class:list={[
                            'gg-chip',
                            meta.spoiler === 'none' ? 'gg-chip--lake' : 'gg-chip--coral',
                          ]}
                        >
                          {SPOILER_LABEL[meta.spoiler]}
                        </span>
                      )}
                    </p>
                    <h2>{p.data.title}</h2>
                    <p class="clip-desc">{p.data.description}</p>
                  </div>
                  <div class="clip-side">
                    <time>{fmtDate(p.data.pubDate)}</time>
                    <span class="clip-read">
                      <PixelIcon name="play" size={11} /> 回放
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="gg-empty">
          <strong>手记存档为空</strong>第一段回放正在整理。
        </p>
      )
    }

    <footer class="page-end">
      <span class="mono-label">{COLUMN.en}</span>
      <nav class="end-links" aria-label="栏目入口">
        <a href="/game/">专栏首页</a>
        <a href="/game/playing/">正在游玩</a>
        <a href="/game/collection/">收藏架</a>
      </nav>
    </footer>
  </div>
</BaseLayout>

<style>
  .notes-page {
    padding-top: clamp(1.4rem, 3.5vw, 2.4rem);
    padding-bottom: clamp(2.4rem, 6vw, 4rem);
  }

  .page-head h1 {
    margin: 0.5rem 0 0;
    font-family: var(--g-disp);
    font-weight: 900;
    font-size: clamp(34px, 5.5vw, 58px);
    color: var(--gg-cream);
    text-shadow: 4px 4px 0 var(--gg-ink);
  }
  .head-en {
    color: var(--gg-acid);
    letter-spacing: 0.32em;
  }
  .head-note {
    max-width: 50ch;
    margin: 0.9rem 0 0;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--gg-cream-dim);
  }

  .clip-list {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.2rem;
  }
  .clip {
    max-width: 880px;
  }
  .clip--tilt {
    transform: rotate(0.5deg);
  }
  .clip-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.2rem;
    padding: 1.05rem 1.2rem 1.15rem;
    color: var(--gg-ink);
    text-decoration: none;
  }
  .clip-row:hover {
    background: rgba(231, 240, 91, 0.28);
  }
  .clip-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0 0 0.65rem;
  }
  .clip h2 {
    margin: 0;
    font-family: var(--g-disp);
    font-weight: 900;
    font-size: clamp(19px, 2.6vw, 26px);
    line-height: 1.4;
  }
  .clip-desc {
    margin: 0.5rem 0 0;
    font-size: 14px;
    line-height: 1.75;
    color: var(--gg-gray);
  }
  .clip-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.8rem;
    white-space: nowrap;
  }
  .clip-side time {
    font-family: var(--g-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--gg-gray);
    font-variant-numeric: tabular-nums;
  }
  .clip-read {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--g-disp);
    font-weight: 800;
    font-size: 13.5px;
    color: var(--gg-ink);
  }
  .clip-row:hover .clip-read {
    color: var(--gg-lake-ink);
  }

  .page-end {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.1rem;
    border-top: 3px solid var(--gg-ink);
  }
  .page-end .mono-label {
    color: var(--gg-cream-dim);
  }
  .end-links {
    display: flex;
    gap: 1.3rem;
  }
  .end-links a {
    color: var(--gg-cream);
    text-decoration: none;
    font-family: var(--g-disp);
    font-weight: 700;
    font-size: 14px;
    padding: 0.3rem 0;
  }
  .end-links a:hover {
    color: var(--gg-acid);
  }

  @media (max-width: 640px) {
    .clip-row {
      grid-template-columns: 1fr;
    }
    .clip-side {
      flex-direction: row;
      align-items: center;
      white-space: normal;
    }
  }
</style>
