---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Room from '../components/room/Room.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPostCategory } from '../utils/categories';

const recent = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  room
  title="徐磊的小房间"
  description="我是徐磊，一名大学生。这里放着我的学习笔记，还有数学、音乐和游戏。"
>
  <div class="room-home">
    <header class="room-heading">
      <p class="welcome">欢迎来坐坐</p>
      <h1>徐磊的小房间<span aria-hidden="true">。</span></h1>
      <p>点点房间里的东西，看看我写的笔记</p>
    </header>
    <Room />
    <section class="recent-notes" aria-labelledby="recent-title">
      <header>
        <h2 id="recent-title">最近写的</h2><a href="/blog/">全部文章 ↗</a>
      </header>
      <ol>
        {
          recent.map((post, index) => (
            <li>
              <span class="note-number" aria-hidden="true">
                0{index + 1}
              </span>
              <div>
                <p class="note-meta">
                  {getPostCategory(post.data).label} ·{' '}
                  <FormattedDate date={post.data.pubDate} />
                </p>
                <h3>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p class="note-description">{post.data.description}</p>
              </div>
              <span class="note-arrow" aria-hidden="true">
                ↗
              </span>
            </li>
          ))
        }
      </ol>
      {recent.length === 0 && <p>还没有笔记，过阵子再来看看。</p>}
    </section>
  </div>
</BaseLayout>

<style is:global>
  body[data-room-home] {
    --room-paper: #faf9f6;
    --room-ink: #292927;
    --room-muted: #77766f;
    background: var(--room-paper) !important;
    color: var(--room-ink);
  }
  html[data-theme='dark'] body[data-room-home] {
    --room-paper: #191a1c;
    --room-ink: #e3e1d9;
    --room-muted: #a7a69f;
  }
  body[data-room-home]::before,
  body[data-room-home]::after {
    display: none !important;
    animation: none !important;
  }
  body[data-room-home] #dark-variant-toggle {
    display: none;
  }
  .room-home {
    width: min(1120px, calc(100% - 48px));
    margin: auto;
  }
  .room-home a {
    color: inherit;
  }
  .room-home a:focus-visible,
  .room-home button:focus-visible {
    outline: 2px solid var(--room-ink);
    outline-offset: 5px;
  }
  .room-heading {
    padding: 48px 0 0;
    text-align: center;
  }
  .room-heading .welcome {
    font-size: 12px;
    letter-spacing: 0.18em;
    margin: 0 0 12px;
    color: var(--room-muted);
  }
  .room-heading h1 {
    font-size: clamp(29px, 4vw, 46px);
    font-weight: 500;
    letter-spacing: 0.025em;
    margin: 0 0 12px;
  }
  .room-heading h1 span {
    margin-left: -0.2em;
  }
  .room-heading > p:last-child {
    color: var(--room-muted);
    font-size: 14px;
    margin: 0;
  }
  .recent-notes {
    max-width: 900px;
    margin: 56px auto 80px;
  }
  .recent-notes > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--room-ink);
  }
  .recent-notes h2 {
    font-size: 23px;
    font-weight: 500;
    margin: 0;
  }
  .recent-notes header a {
    font-size: 13px;
  }
  .recent-notes ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .recent-notes li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 20px;
    gap: 12px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .note-number,
  .note-meta {
    font-size: 12px;
    color: var(--room-muted);
    margin: 0 0 7px;
  }
  .note-number {
    font-family: var(--font-mono);
    padding-top: 3px;
  }
  .recent-notes h3 {
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .note-description {
    color: var(--room-muted);
    font-size: 13px;
    line-height: 1.8;
    margin: 8px 0 0;
  }
  .note-arrow {
    align-self: center;
  }
  @media (max-width: 600px) {
    .room-home {
      width: calc(100% - 32px);
    }
    .room-heading {
      padding-top: 32px;
    }
    .room-heading > p:last-child {
      font-size: 12px;
    }
    .recent-notes {
      margin-top: 36px;
    }
    .recent-notes li {
      grid-template-columns: 24px minmax(0, 1fr) 16px;
      gap: 8px;
    }
    .recent-notes h3 {
      font-size: 18px;
    }
  }
</style>
