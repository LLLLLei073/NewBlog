---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts.ts';
---

<BaseLayout>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p>{SITE_DESCRIPTION}</p>
    <div class="actions">
      <a href="/blog" class="button primary">浏览文章</a>
      <a href="/about" class="button">关于我</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0 3rem;
    text-align: center;
  }
  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .hero p {
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 500px;
    margin: 0 auto 2rem;
  }
  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .button {
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 600;
    transition: all 0.2s ease;
  }
  .button:hover {
    text-decoration: none;
    background: var(--accent-light);
  }
  .button.primary {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }
  .button.primary:hover {
    opacity: 0.9;
  }
</style>
