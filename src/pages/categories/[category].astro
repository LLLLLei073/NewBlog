---
/**
 * /categories/<id>/ 旧分类页已退役:五个专栏都有独立首页后,这里只生成
 * meta refresh + canonical 迁移桩,保住历史外链与 SEO。静态托管无服务器
 * 301,与 /blog/<slug>/ 迁移桩保持同一结构。
 */
import { CATEGORIES, type CategoryDef } from '../../utils/categories.ts';
import { SITE_URL } from '../../consts.ts';

export async function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

interface Props {
  category: CategoryDef;
}

const { category } = Astro.props;
const target = category.path;
const canonicalUrl = new URL(target, Astro.site ?? SITE_URL).toString();
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`专栏：${category.label}`}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>
      「{category.label}」专栏已改版,正在前往
      <a href={target}>新专栏首页</a>……
    </p>
  </body>
</html>
