---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于" description="关于我和这个博客">
  <section class="container about">
    <div class="page-head">
      <p class="eyebrow">关于</p>
      <h1>关于</h1>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
    max-width: 760px;
  }

  .page-head {
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary);
    margin: 0 0 0.5rem;
  }

  .page-head h1 {
    font-size: 2rem;
    margin: 0;
  }

  @media (max-width: 640px) {
    .about {
      padding-top: 1.75rem;
      padding-bottom: 2rem;
    }

    .page-head h1 {
      font-size: 1.6rem;
    }
  }
</style>
