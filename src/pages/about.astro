---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于" description="关于我和这个博客">
  <section class="container about">
    <div class="page-head">
      <p class="eyebrow">关于</p>
      <h1>关于</h1>
    </div>

    <!-- 我的设备：实时状态 -->
    <div class="block devices">
      <div class="block-title">
        <h2 class="block-h">我的设备</h2>
        <span class="live-badge"><span class="live-dot"></span>实时</span>
      </div>
      <p class="block-sub">电脑和手机的实时状态，由本机脚本自动上报。</p>

      <div class="device-grid">
        <div class="device-card" data-device="pc">
          <div class="device-head">
            <span class="device-icon">💻</span>
            <span class="device-name">电脑</span>
            <span class="device-status" data-status-dot></span>
          </div>
          <p class="device-activity" data-activity>连接中…</p>
          <p class="device-detail" data-detail></p>
          <p class="device-updated" data-updated></p>
          <button class="manual-btn" data-manual>设为离开</button>
          <div class="device-info" data-info hidden>
            <div class="info-row"><span class="info-k">主机</span><span class="info-v" data-info-host></span></div>
            <div class="info-row"><span class="info-k">系统</span><span class="info-v" data-info-os></span></div>
            <div class="info-row"><span class="info-k">CPU</span><span class="info-v" data-info-cpu></span></div>
            <div class="info-row"><span class="info-k">GPU</span><span class="info-v" data-info-gpu></span></div>
            <div class="info-row"><span class="info-k">内存</span><span class="info-v" data-info-ram></span></div>
            <div class="info-row"><span class="info-k">运行时长</span><span class="info-v" data-info-uptime></span></div>
          </div>
        </div>

        <div class="device-card" data-device="phone">
          <div class="device-head">
            <span class="device-icon">📱</span>
            <span class="device-name">手机</span>
            <span class="device-status" data-status-dot></span>
          </div>
          <p class="device-activity" data-activity>连接中…</p>
          <p class="device-detail" data-detail></p>
          <p class="device-updated" data-updated></p>
        </div>
      </div>
    </div>

    <!-- 今日活动时间轴 -->
    <div class="block timeline">
      <div class="block-title">
        <h2 class="block-h">今日时间轴</h2>
        <span class="live-badge"><span class="live-dot"></span>实时</span>
      </div>
      <p class="block-sub">今天每个时间段在做什么。</p>
      <div class="timeline-list" data-timeline>
        <p class="timeline-empty">暂无记录</p>
      </div>
    </div>

    <!-- 今日统计 -->
    <div class="block stats">
      <div class="block-title">
        <h2 class="block-h">今日统计</h2>
      </div>
      <p class="block-sub">今天的活动时长分布。</p>
      <div class="stats-list" data-stats>
        <p class="stats-empty">暂无数据</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    max-width: 760px;
  }

  .page-head {
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary);
    margin: 0 0 0.5rem;
  }

  .page-head h1 {
    font-size: 2rem;
    margin: 0;
  }

  /* ===== 我的设备 ===== */
  .block {
    margin-top: 2.5rem;
  }

  .block-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.25rem;
  }

  .block-h {
    font-size: 1.2rem;
    margin: 0;
  }

  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--primary);
    background: var(--brand-100);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: live-pulse 1.6s ease-in-out infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
    50% { opacity: 0.7; box-shadow: 0 0 0 4px rgba(34, 197, 94, 0); }
  }

  .block-sub {
    font-size: 0.85rem;
    color: var(--muted-foreground);
    margin: 0 0 1.25rem;
  }

  .device-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .device-card {
    padding: 1.1rem 1.2rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .device-card:hover {
    border-color: var(--brand-300);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .device-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .device-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .device-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
  }

  .device-status {
    margin-left: auto;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--muted-foreground);
    opacity: 0.4;
    transition: background-color 0.3s ease, opacity 0.3s ease, box-shadow 0.3s ease;
  }

  .device-card.online .device-status {
    background: #22c55e;
    opacity: 1;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
  }

  .device-activity {
    font-size: 0.95rem;
    font-weight: 500;
    margin: 0 0 0.2rem;
    min-height: 1.4em;
  }

  .device-detail {
    font-size: 0.82rem;
    color: var(--muted-foreground);
    margin: 0 0 0.5rem;
    min-height: 1.2em;
  }

  .device-updated {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
    opacity: 0.75;
    margin: 0;
  }

  .device-info {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border);
    display: grid;
    gap: 0.3rem;
  }

  .info-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .info-k {
    flex-shrink: 0;
    width: 3.5em;
    color: var(--muted-foreground);
    font-family: var(--font-sans);
  }

  .info-v {
    color: var(--foreground);
    font-family: var(--font-mono);
    word-break: break-all;
    opacity: 0.85;
  }

  .manual-btn {
    margin-top: 0.6rem;
    padding: 0.25rem 0.7rem;
    font-size: 0.72rem;
    font-family: var(--font-sans);
    color: var(--muted-foreground);
    background: transparent;
    border: 1px dashed var(--border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .manual-btn:hover {
    color: var(--primary);
    border-color: var(--brand-300);
    transform: translateY(-1px);
  }

  .manual-btn:active {
    transform: scale(0.96);
  }

  /* ===== 今日时间轴 ===== */
  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .timeline-item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.35rem 0;
    position: relative;
  }

  .timeline-time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
    flex-shrink: 0;
    width: 3.4em;
  }

  .timeline-dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-400);
    margin-top: 0.35em;
  }

  .timeline-activity {
    font-size: 0.85rem;
    color: var(--foreground);
  }

  .timeline-detail {
    font-size: 0.75rem;
    color: var(--muted-foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 55%;
  }

  .timeline-empty,
  .stats-empty {
    font-size: 0.85rem;
    color: var(--muted-foreground);
    opacity: 0.7;
    margin: 0.25rem 0;
  }

  /* ===== 今日统计 ===== */
  .stats-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .stat-row {
    display: grid;
    grid-template-columns: 6.5em 1fr 5.5em;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
  }

  .stat-name {
    color: var(--foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stat-bar {
    height: 7px;
    background: var(--brand-100);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .stat-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--brand-400), var(--primary));
    border-radius: var(--radius-full);
    transition: width 0.6s ease;
  }

  .stat-dur {
    font-family: var(--font-mono);
    color: var(--muted-foreground);
    text-align: right;
  }

  @media (max-width: 640px) {
    .about {
      padding-top: 1.75rem;
    }

    .page-head h1 {
      font-size: 1.6rem;
    }
  }
</style>

<script>
  /* 设备实时状态：轮询 /status.json，30 秒刷新一次 */
  function initDevices() {
    const cards = Array.from(document.querySelectorAll('[data-device]'));
    const timelineEl = document.querySelector('[data-timeline]');
    const statsEl = document.querySelector('[data-stats]');
    const manualBtn = document.querySelector('[data-manual]');

    const escapeHtml = (s: string) =>
      String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

    const fmtTime = (iso: string) => {
      if (!iso) return '';
      const d = new Date(iso);
      const now = Date.now();
      const diff = Math.max(0, Math.round((now - d.getTime()) / 60000));
      if (diff < 1) return '刚刚';
      if (diff < 60) return `${diff} 分钟前`;
      return d.toLocaleString('zh-CN', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    };

    const fmtHM = (iso: string) =>
      new Date(iso).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });

    const fmtDur = (sec: number) => {
      const m = Math.floor(sec / 60);
      if (m < 60) return `${m} 分钟`;
      return `${Math.floor(m / 60)} 小时 ${m % 60} 分`;
    };

    /* 手动状态覆盖（localStorage，30 分钟自动恢复） */
    const getManual = () => {
      try {
        const raw = localStorage.getItem('manual-status');
        if (!raw) return null;
        const m = JSON.parse(raw);
        if (m.until > Date.now()) return m;
        localStorage.removeItem('manual-status');
      } catch {}
      return null;
    };

    manualBtn?.addEventListener('click', () => {
      const until = Date.now() + 30 * 60 * 1000;
      localStorage.setItem('manual-status', JSON.stringify({ activity: '离开', until }));
      manualBtn.textContent = '已设为离开（30 分钟）';
      refresh();
      setTimeout(() => { manualBtn.textContent = '设为离开'; refresh(); }, 2500);
    });

    const render = (data: any) => {
      const manual = getManual();
      cards.forEach((card) => {
        const key = card.getAttribute('data-device');
        const dev = data?.[key];
        const dot = card.querySelector('[data-status-dot]') as HTMLElement;
        const act = card.querySelector('[data-activity]') as HTMLElement;
        const det = card.querySelector('[data-detail]') as HTMLElement;
        const upd = card.querySelector('[data-updated]') as HTMLElement;

        const online = dev?.online === true;
        card.classList.toggle('online', online);
        act.textContent = dev?.activity || (online ? '在线' : '离线');
        det.textContent = dev?.detail || '';
        upd.textContent = dev?.updatedAt ? `更新于 ${fmtTime(dev.updatedAt)}` : '';

        if (key === 'pc' && manual) {
          act.textContent = `${manual.activity}（手动）`;
          det.textContent = '手动设置，30 分钟后自动恢复';
          card.classList.add('online');
        }

        // 电脑信息：仅在线时显示
        if (key === 'pc' && online && dev.sysinfo) {
          const info = card.querySelector('[data-info]') as HTMLElement;
          (card.querySelector('[data-info-host]') as HTMLElement).textContent = dev.sysinfo.host || '';
          (card.querySelector('[data-info-os]') as HTMLElement).textContent = dev.sysinfo.os || '';
          (card.querySelector('[data-info-cpu]') as HTMLElement).textContent = dev.sysinfo.cpu || '';
          (card.querySelector('[data-info-gpu]') as HTMLElement).textContent = dev.sysinfo.gpu || '';
          (card.querySelector('[data-info-ram]') as HTMLElement).textContent = dev.sysinfo.ram || '';
          (card.querySelector('[data-info-uptime]') as HTMLElement).textContent = dev.sysinfo.uptime || '';
          info.hidden = false;
        } else if (key === 'pc') {
          (card.querySelector('[data-info]') as HTMLElement).hidden = true;
        }
      });

      // 今日时间轴
      if (timelineEl) {
        const history = Array.isArray(data?.history) ? data.history : [];
        const today = new Date().toLocaleDateString('zh-CN');
        const items = history.filter((h: any) => h.t && new Date(h.t).toLocaleDateString('zh-CN') === today).slice(-30);
        timelineEl.innerHTML = items.length
          ? items.map((h: any) => `
              <div class="timeline-item">
                <span class="timeline-time">${fmtHM(h.t)}</span>
                <span class="timeline-dot"></span>
                <span class="timeline-activity">${escapeHtml(h.activity)}</span>
                ${h.detail ? `<span class="timeline-detail">${escapeHtml(h.detail)}</span>` : ''}
              </div>`).join('')
          : '<p class="timeline-empty">暂无记录</p>';
      }

      // 今日统计
      if (statsEl) {
        const stats = data?.daily?.stats;
        const entries = stats ? Object.entries(stats).filter(([, v]) => (v as number) > 0).sort((a, b) => (b[1] as number) - (a[1] as number)) : [];
        const total = entries.reduce((s, [, v]) => s + (v as number), 0);
        statsEl.innerHTML = entries.length
          ? entries.map(([k, v]) => `
              <div class="stat-row">
                <span class="stat-name">${escapeHtml(k)}</span>
                <div class="stat-bar"><div class="stat-fill" style="width:${Math.round(((v as number) / total) * 100)}%"></div></div>
                <span class="stat-dur">${fmtDur(v as number)}</span>
              </div>`).join('')
          : '<p class="stats-empty">暂无数据</p>';
      }
    };

    const refresh = async () => {
      try {
        // 加时间戳 query 绕过 GitHub Pages 强制的 10min CDN 缓存
        const res = await fetch('/status.json?_=' + Date.now(), { cache: 'no-store' });
        if (!res.ok) throw new Error(res.status + '');
        render(await res.json());
      } catch {
        cards.forEach((card) => {
          card.classList.remove('online');
          (card.querySelector('[data-activity]') as HTMLElement).textContent = '状态获取失败';
        });
      }
    };

    refresh();
    setInterval(refresh, 30000);
  }

  document.addEventListener('astro:after-swap', initDevices);
  initDevices();
</script>
