---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import CodeBlockEnhance from '../components/CodeBlockEnhance.astro';
import MermaidEnhance from '../components/MermaidEnhance.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  SITE_AUTHOR,
} from '../consts.ts';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  room?: boolean;
  /** 页面标识,渲染为 body[data-page],供播放器等全局组件区分页面 */
  pageName?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = '/og.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  room = false,
  pageName,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* 页面过渡:导航变为 DOM swap,让持久化的音乐播放器跨页面连续播放 */}
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#d97757" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE_AUTHOR} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, SITE_URL)} />
    {
      type === 'article' && publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      type === 'article' && modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    {
      type === 'article' && (
        <meta property="article:author" content={SITE_AUTHOR} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, SITE_URL)} />
    <ThemeInit />
    <script
      is:inline
      define:vars={{ enableServiceWorker: import.meta.env.PROD }}
    >
      if (enableServiceWorker && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body data-room-home={room ? '' : undefined} data-page={pageName}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CodeBlockEnhance />
    <MermaidEnhance />
    <MusicPlayer />
  </body>
</html>
