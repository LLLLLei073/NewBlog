---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import { getCollection } from 'astro:content';
import { readingTime, wordCount } from '../utils/reading';

type Heading = { depth: number; slug: string; text: string };
type Nav = { slug: string; title: string } | null;
type Related = { slug: string; title: string; description: string; pubDate: Date; category: string | null };
type SeriesPost = { slug: string; title: string };

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  headings?: Heading[];
  newer?: Nav;
  older?: Nav;
  related?: Related[];
  rawBody?: string;
  seriesPosts?: SeriesPost[];
  seriesName?: string | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  headings = [],
  newer = null,
  older = null,
  related = [],
  rawBody = '',
  seriesPosts = [],
  seriesName = null,
} = Astro.props;

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = toc.length > 1;
const readMinutes = readingTime(rawBody);
const words = wordCount(rawBody);

// 构建文章列表用于左侧导航
const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <div class="post-layout">
    <!-- 左侧边栏:文章导航 -->
    <aside class="sidebar-left">
      <nav class="article-nav" aria-label="文章导航">
        <p class="sidebar-title">文章列表</p>
        <ul>
          {allPosts.map((post) => {
            const isActive = currentPath === `/blog/${post.id}/`;
            return (
              <li class:list={['nav-item', { active: isActive }]}>
                <a href={`/blog/${post.id}/`} class:list={[{ active: isActive }]}>{post.data.title}</a>
              </li>
            );
          })}
        </ul>
      </nav>
    </aside>

    <!-- 主内容区 -->
    <article class="post-main">
      <a href="/blog" class="back">&larr; 返回文章列表</a>

      <header class="article-head">
        <h1>{title}</h1>
        <div class="meta">
          <span class="meta-item"><FormattedDate date={pubDate} /></span>
          <span class="meta-sep">·</span>
          <span class="meta-item">{readMinutes} 分钟阅读</span>
          <span class="meta-sep">·</span>
          <span class="meta-item">{words.toLocaleString('zh-CN')} 字</span>
          {
            updatedDate && (
              <>
                <span class="meta-sep">·</span>
                <span class="meta-item updated">更新于 <FormattedDate date={updatedDate} /></span>
              </>
            )
          }
        </div>
      </header>

      {heroImage && <img src={heroImage} alt={title} class="hero-img" />}

      <div class="post-content">
        <div class="prose">
          <slot />
        </div>
      </div>

      {
        (newer || older) && (
          <nav class="prev-next" aria-label="文章导航">
            {newer ? (
              <a class="pn-link newer" href={`/blog/${newer.slug}/`}>
                <span class="pn-label">&larr; 上一篇</span>
                <span class="pn-title">{newer.title}</span>
              </a>
            ) : (
              <span class="pn-placeholder" />
            )}
            {older ? (
              <a class="pn-link older" href={`/blog/${older.slug}/`}>
                <span class="pn-label">下一篇 &rarr;</span>
                <span class="pn-title">{older.title}</span>
              </a>
            ) : (
              <span class="pn-placeholder" />
            )}
          </nav>
        )
      }

      {seriesName && seriesPosts.length > 0 && (
        <section class="series" aria-label="本系列">
          <h2 class="series-title">📚 系列：{seriesName}</h2>
          <ul class="series-list">
            {seriesPosts.map((s) => (
              <li>
                <a href={`/blog/${s.slug}/`} class="series-link">{s.title}</a>
              </li>
            ))}
            <li>
              <span class="series-current">📄 {title}（当前）</span>
            </li>
          </ul>
        </section>
      )}

      {related.length > 0 && (
        <section class="related" aria-label="推荐阅读">
          <h2 class="related-title">📖 推荐阅读</h2>
          <ul class="related-list">
            {related.map((r) => (
              <li>
                <a href={`/blog/${r.slug}/`} class="related-card">
                  <div class="related-meta">
                    <FormattedDate date={r.pubDate} />
                    {r.category && <span class="related-cat">{r.category}</span>}
                  </div>
                  <h3 class="related-h">{r.title}</h3>
                  <p class="related-desc">{r.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="share" aria-label="分享">
        <span class="share-label">分享</span>
        <button class="share-btn" type="button" data-share="link">🔗 复制链接</button>
        <button class="share-btn" type="button" data-share="text">📋 复制分享文案</button>
      </div>
    </article>

    <!-- 评论区 -->
    <div class="comments-wrap">
      <Comments />
    </div>

    <!-- 右侧边栏:文章目录 -->
    {hasToc && (
      <aside class="sidebar-right">
        <TableOfContents toc={toc} />
      </aside>
    )}
  </div>

  <!-- 移动端悬浮导航（桌面端有侧栏，自动隐藏） -->
  <button
    id="fab-nav"
    class="fab"
    type="button"
    aria-label="文章导航"
    aria-expanded="false"
    aria-controls="fab-panel"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
      <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
    </svg>
  </button>

  <div id="fab-panel" class="fab-panel" aria-hidden="true">
    <div class="fab-tabs">
      <button id="fab-tab-toc" class="fab-tab active" type="button">目录</button>
      <button id="fab-tab-posts" class="fab-tab" type="button">文章</button>
    </div>
    <div id="fab-body-toc" class="fab-body">
      {toc.length > 0 ? (
        <ul class="fab-list">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`} class:list={['fab-item', h.depth === 3 ? 'sub' : '']}>{h.text}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="fab-empty">这篇文章没有目录</p>
      )}
    </div>
    <div id="fab-body-posts" class="fab-body" hidden>
      <ul class="fab-list">
        {allPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}/`}
              class:list={['fab-item', { active: currentPath === `/blog/${post.id}/` }]}
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: 50;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0;
    background: var(--primary);
    transition: width 0.08s linear;
  }

  .post-layout {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 1rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* 左侧边栏 */
  .sidebar-left {
    display: none;
  }

  .article-nav {
    font-family: var(--font-sans);
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    max-height: calc(100vh - var(--header-height) - 3rem);
    overflow-y: auto;
  }

  .sidebar-title {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
    margin: 0 0 0.6rem;
    padding: 0 0.5rem;
  }

  .article-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item {
    margin: 0;
  }

  .nav-item a {
    display: block;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--muted-foreground);
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .nav-item a:hover {
    background: var(--muted);
    color: var(--foreground);
    text-decoration: none;
  }

  .nav-item a.active {
    background: var(--brand-100);
    color: var(--brand-700);
    font-weight: 500;
  }

  :global(html[data-theme='dark']) .nav-item a.active {
    background: var(--brand-100);
    color: var(--brand-300);
  }

  /* 评论区：固定白色卡片，不随亮暗主题切换（暗色下也保持白底，保证可读性） */
  .comments-wrap {
    grid-column: 1 / -1;
    min-width: 0;
    background: #ffffff;
    border: 1px solid #e3e6ec;
    border-radius: var(--radius);
    padding: 1.5rem 1.25rem 0.5rem;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 1024px) {
    .comments-wrap {
      grid-column: 2;
    }
  }

  /* 右侧 TOC */
  .sidebar-right {
    display: none;
  }

  /* 主内容区 */
  .post-main {
    max-width: 768px;
  }

  .back {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted-foreground);
    margin-bottom: 1.5rem;
    transition: color 0.15s ease;
  }

  .back:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .article-head {
    margin-bottom: 2rem;
  }

  .article-head h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0 0 0.75rem;
    color: var(--card-foreground);
  }

  .meta {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--muted-foreground);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .meta-sep {
    color: var(--text-400);
  }

  .updated {
    color: var(--muted-foreground);
  }

  .hero-img {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .pn-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.25rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.2s ease;
  }

  .pn-link:hover {
    text-decoration: none;
    border-color: var(--brand-300);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .pn-link.older {
    text-align: right;
  }

  .pn-placeholder {
    visibility: hidden;
  }

  .pn-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .pn-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--card-foreground);
    line-height: 1.35;
  }

  /* ===== 本系列 ===== */
  .series {
    margin-top: 3rem;
    padding: 1.1rem 1.3rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .series-title {
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
    color: var(--foreground);
  }

  .series-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .series-list li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .series-link {
    color: var(--primary);
    text-decoration: none;
  }

  .series-link:hover {
    text-decoration: underline;
  }

  .series-current {
    color: var(--muted-foreground);
  }

  /* ===== 分享 ===== */
  .share {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .share-label {
    font-size: 0.8rem;
    color: var(--muted-foreground);
    margin-right: 0.25rem;
  }

  .share-btn {
    padding: 0.35rem 0.85rem;
    font-size: 0.78rem;
    font-family: var(--font-sans);
    color: var(--foreground);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease, color 0.15s ease;
  }

  .share-btn:hover {
    border-color: var(--brand-300);
    color: var(--primary);
    transform: translateY(-1px);
  }

  .share-btn:active {
    transform: scale(0.96);
  }

  .share-btn.copied {
    color: #22c55e;
    border-color: #22c55e;
  }

  /* ===== 图片灯箱 ===== */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(5, 8, 20, 0.88);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
  }

  .lightbox.open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox img {
    max-width: 92vw;
    max-height: 88vh;
    border-radius: var(--radius);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    cursor: zoom-out;
  }

  .lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .prose img {
    cursor: zoom-in;
  }

  @media (max-width: 640px) {
    .share {
      flex-wrap: wrap;
    }
  }

  /* ===== 推荐阅读 ===== */
  .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border);
  }

  .related-title {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted-foreground);
    margin: 0 0 1rem;
  }

  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .related-card {
    display: block;
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .related-card:hover {
    text-decoration: none;
    border-color: var(--brand-300);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .related-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
    margin-bottom: 0.4rem;
  }

  .related-cat {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    background: var(--brand-100);
    color: var(--brand-700);
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    text-transform: capitalize;
  }

  :global(html[data-theme='dark']) .related-cat {
    color: var(--brand-300);
  }

  .related-h {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    margin: 0 0 0.3rem;
    color: var(--foreground);
    line-height: 1.35;
  }

  .related-desc {
    font-size: 0.8rem;
    color: var(--muted-foreground);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 返回顶部 ===== */
  .back-to-top {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--card);
    color: var(--muted-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    z-index: 40;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease,
      background-color 0.15s ease, color 0.15s ease;
    -webkit-tap-highlight-color: transparent;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  .back-to-top:hover {
    color: var(--primary);
    border-color: var(--brand-300);
  }

  .back-to-top:active {
    transform: translateY(0) scale(0.92);
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* 有 FAB 时（窄屏）——返回顶部抬高到 FAB 上方 */
  :global(body:has(.fab)) .back-to-top {
    bottom: calc(4.75rem + env(safe-area-inset-bottom));
  }

  /* ===== 移动端悬浮导航（FAB） ===== */
  .fab {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    width: 50px;
    height: 50px;
    display: none; /* 桌面端有侧栏，隐藏 */
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: var(--primary-foreground);
    box-shadow: var(--shadow-lg);
    cursor: pointer;
    z-index: 45;
    transition: transform 0.15s ease, background-color 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .fab:hover {
    background: var(--brand-600);
  }

  .fab:active {
    transform: scale(0.9);
  }

  .fab-panel {
    position: fixed;
    right: 1rem;
    bottom: calc(4.75rem + env(safe-area-inset-bottom));
    width: min(320px, calc(100vw - 2rem));
    max-height: 55vh;
    display: flex;
    flex-direction: column;
    background: var(--popover);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    z-index: 45;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.98);
    transform-origin: bottom right;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }

  .fab-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .fab-tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem 0.5rem 0;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .fab-tab {
    flex: 1;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted-foreground);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .fab-tab:hover {
    color: var(--foreground);
  }

  .fab-tab.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  .fab-body {
    padding: 0.5rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .fab-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .fab-item {
    display: block;
    padding: 0.55rem 0.75rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
    border-radius: var(--radius-md);
    line-height: 1.4;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .fab-item:hover {
    background: var(--muted);
    color: var(--foreground);
    text-decoration: none;
  }

  .fab-item.active {
    background: var(--brand-100);
    color: var(--brand-700);
    font-weight: 500;
  }

  :global(html[data-theme='dark']) .fab-item.active {
    color: var(--brand-300);
  }

  .fab-item.sub {
    padding-left: 1.5rem;
    font-size: 0.82rem;
  }

  .fab-empty {
    font-size: 0.85rem;
    color: var(--muted-foreground);
    padding: 0.75rem;
    text-align: center;
    margin: 0;
  }

  /* FAB：<1280px 显示（桌面三栏有悬浮 TOC；两栏/窄屏用悬浮球导航） */
  @media (max-width: 1279px) {
    .fab {
      display: inline-flex;
    }
  }

  /* 三栏布局:大屏显示 */
  @media (min-width: 1280px) {
    .post-layout {
      grid-template-columns: 200px minmax(0, 1fr) 200px;
    }

    .sidebar-left {
      display: block;
    }

    /* TOC 改为 fixed 悬浮：固定在视口右侧，滚动始终跟随，不停留在文章末尾 */
    .sidebar-right {
      display: block;
      position: fixed;
      right: 1.25rem;
      top: 50%;
      transform: translateY(-50%);
      width: 200px;
      max-height: calc(100vh - var(--header-height) - 3rem);
      z-index: 25;
    }

    .sidebar-right :global(.toc) {
      max-height: calc(100vh - var(--header-height) - 3rem);
      overflow-y: auto;
      padding: 0.9rem 0.9rem 0.9rem 0.75rem;
      background: var(--popover);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
      backdrop-filter: blur(14px) saturate(140%);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
    }

    .post-main {
      max-width: none;
    }
  }

  /* 中屏:两栏(左侧导航 + 正文) */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .post-layout {
      grid-template-columns: 200px minmax(0, 1fr);
    }

    .sidebar-left {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .post-layout {
      padding: 1.25rem 1rem 1rem;
      gap: 1.5rem;
    }

    .article-head {
      margin-bottom: 1.5rem;
    }

    .article-head h1 {
      font-size: 1.5rem;
    }

    .meta {
      font-size: 0.72rem;
      gap: 0.3rem;
    }

    .back {
      margin-bottom: 1.25rem;
    }

    .prev-next {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
    }

    .pn-link {
      padding: 0.9rem 1rem;
    }

    .pn-link.older {
      text-align: left;
    }

    .pn-placeholder {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .article-head h1 {
      font-size: 1.35rem;
    }

    /* 窄屏下代码块/表格字号略降，减少横向滚动需求 */
    .prose pre {
      font-size: 0.78rem;
    }
  }
</style>

<script>
  function initProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;
    const update = () => {
      const el = document.documentElement;
      const total = el.scrollHeight - el.clientHeight;
      const pct = total > 0 ? (el.scrollTop / total) * 100 : 0;
      bar.style.width = pct + '%';
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  function initFab() {
    const fab = document.getElementById('fab-nav');
    const panel = document.getElementById('fab-panel');
    if (!fab || !panel) return;

    const setOpen = (open: boolean) => {
      fab.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('open', open);
      panel.setAttribute('aria-hidden', String(!open));
    };

    fab.addEventListener('click', () => {
      setOpen(fab.getAttribute('aria-expanded') !== 'true');
    });

    // 面板内点击链接后关闭
    panel.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;
      if (target.closest('a')) setOpen(false);
    });

    // Tab 切换：目录 / 文章
    const tabs = Array.from(panel.querySelectorAll('.fab-tab')) as HTMLButtonElement[];
    const bodies = [panel.querySelector('#fab-body-toc'), panel.querySelector('#fab-body-posts')];
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.toggle('active', t === tab));
        bodies.forEach((b, j) => {
          if (b) b.toggleAttribute('hidden', j !== i);
        });
      });
    });

    // ESC 关闭
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') setOpen(false);
    });

    // 视口变宽（回到桌面有悬浮 TOC）时复位
    const mq = window.matchMedia('(min-width: 1280px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // 支持页面导航后重新绑定（Astro View Transitions）
  document.addEventListener('astro:after-swap', initFab);
  initProgress();
  initFab();

  // 返回顶部：滚动一段距离后显示，点击平滑回顶
  function initBackToTop() {
    let btn = document.getElementById('back-to-top');
    if (!btn) {
      btn = document.createElement('button');
      btn.id = 'back-to-top';
      btn.type = 'button';
      btn.className = 'back-to-top';
      btn.setAttribute('aria-label', '返回顶部');
      btn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>`;
      document.body.appendChild(btn);
    }

    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop;
      btn!.classList.toggle('visible', y > 600);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  document.addEventListener('astro:after-swap', initBackToTop);
  initBackToTop();

  // 图片灯箱：点击文章图片全屏预览
  function initLightbox() {
    const imgs = Array.from(document.querySelectorAll('.prose img'));
    if (!imgs.length) return;

    let lb = document.querySelector('.lightbox') as HTMLElement | null;
    if (!lb) {
      lb = document.createElement('div');
      lb.className = 'lightbox';
      lb.innerHTML = `<button class="lightbox-close" aria-label="关闭">×</button><img alt="" />`;
      document.body.appendChild(lb);
    }
    const imgEl = lb.querySelector('img') as HTMLImageElement;
    const close = () => lb!.classList.remove('open');
    (lb.querySelector('.lightbox-close') as HTMLElement).addEventListener('click', close);
    lb.addEventListener('click', (e) => {
      if (e.target === lb || (e.target as HTMLElement).tagName === 'IMG') close();
    });
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && lb!.classList.contains('open')) close();
    });

    imgs.forEach((img) => {
      img.addEventListener('click', () => {
        if (!img.src) return;
        imgEl.src = img.src;
        imgEl.alt = img.alt || '';
        lb!.classList.add('open');
      });
    });
  }
  document.addEventListener('astro:after-swap', initLightbox);
  initLightbox();

  // 分享按钮：复制链接 / 复制分享文案
  function initShare() {
    const buttons = Array.from(document.querySelectorAll('[data-share]')) as HTMLButtonElement[];
    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const title = document.title.replace(/ \| .*$/, '');
        const url = location.href;
        const text = btn.dataset.share === 'link' ? url : `${title} ${url}`;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        const original = btn.textContent;
        btn.textContent = '✅ 已复制';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('copied');
        }, 1600);
      });
    });
  }
  document.addEventListener('astro:after-swap', initShare);
  initShare();

  // 键盘导航：← / → 切换上一篇 / 下一篇
  function initKeyNav() {
    const newerLink = document.querySelector<HTMLAnchorElement>('.pn-link.newer');
    const olderLink = document.querySelector<HTMLAnchorElement>('.pn-link.older');
    if (!newerLink && !olderLink) return;

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      const typing =
        target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.isContentEditable ||
        target.closest('[contenteditable]') !== null;
      if (typing) return;
      if (e.key === 'ArrowLeft' && newerLink) {
        location.href = newerLink.href;
      } else if (e.key === 'ArrowRight' && olderLink) {
        location.href = olderLink.href;
      }
    });
  }
  document.addEventListener('astro:after-swap', initKeyNav);
  initKeyNav();
</script>
