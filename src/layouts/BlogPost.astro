---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../utils/reading';

type Heading = { depth: number; slug: string; text: string };
type Nav = { slug: string; title: string } | null;

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  headings?: Heading[];
  newer?: Nav;
  older?: Nav;
  rawBody?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  headings = [],
  newer = null,
  older = null,
  rawBody = '',
} = Astro.props;

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = toc.length > 1;
const readMinutes = readingTime(rawBody);

// 构建文章列表用于左侧导航
const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <div class="post-layout">
    <!-- 左侧边栏:文章导航 -->
    <aside class="sidebar-left">
      <nav class="article-nav" aria-label="文章导航">
        <p class="sidebar-title">文章列表</p>
        <ul>
          {allPosts.map((post) => {
            const isActive = currentPath === `/blog/${post.id}/`;
            return (
              <li class:list={['nav-item', { active: isActive }]}>
                <a href={`/blog/${post.id}/`} class:list={[{ active: isActive }]}>{post.data.title}</a>
              </li>
            );
          })}
        </ul>
      </nav>
    </aside>

    <!-- 主内容区 -->
    <article class="post-main">
      <a href="/blog" class="back">&larr; 返回文章列表</a>

      <header class="article-head">
        <h1>{title}</h1>
        <div class="meta">
          <span class="meta-item"><FormattedDate date={pubDate} /></span>
          <span class="meta-sep">·</span>
          <span class="meta-item">{readMinutes} 分钟阅读</span>
          {
            updatedDate && (
              <>
                <span class="meta-sep">·</span>
                <span class="meta-item updated">更新于 <FormattedDate date={updatedDate} /></span>
              </>
            )
          }
        </div>
      </header>

      {heroImage && <img src={heroImage} alt={title} class="hero-img" />}

      <div class="post-content">
        <div class="prose">
          <slot />
        </div>
      </div>

      {
        (newer || older) && (
          <nav class="prev-next" aria-label="文章导航">
            {newer ? (
              <a class="pn-link newer" href={`/blog/${newer.slug}/`}>
                <span class="pn-label">&larr; 上一篇</span>
                <span class="pn-title">{newer.title}</span>
              </a>
            ) : (
              <span class="pn-placeholder" />
            )}
            {older ? (
              <a class="pn-link older" href={`/blog/${older.slug}/`}>
                <span class="pn-label">下一篇 &rarr;</span>
                <span class="pn-title">{older.title}</span>
              </a>
            ) : (
              <span class="pn-placeholder" />
            )}
          </nav>
        )
      }
    </article>

    <!-- 评论区 -->
    <div class="comments-wrap">
      <Comments />
    </div>

    <!-- 右侧边栏:文章目录 -->
    {hasToc && (
      <aside class="sidebar-right">
        <TableOfContents toc={toc} />
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: 50;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0;
    background: var(--primary);
    transition: width 0.08s linear;
  }

  .post-layout {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 1rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* 左侧边栏 */
  .sidebar-left {
    display: none;
  }

  .article-nav {
    font-family: var(--font-sans);
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    max-height: calc(100vh - var(--header-height) - 3rem);
    overflow-y: auto;
  }

  .sidebar-title {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
    margin: 0 0 0.6rem;
    padding: 0 0.5rem;
  }

  .article-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item {
    margin: 0;
  }

  .nav-item a {
    display: block;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--muted-foreground);
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .nav-item a:hover {
    background: var(--muted);
    color: var(--foreground);
    text-decoration: none;
  }

  .nav-item a.active {
    background: var(--brand-100);
    color: var(--brand-700);
    font-weight: 500;
  }

  :global(html[data-theme='dark']) .nav-item a.active {
    background: var(--brand-100);
    color: var(--brand-300);
  }

  /* 评论区：默认占满单栏，宽屏时跟随正文列 */
  .comments-wrap {
    grid-column: 1 / -1;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .comments-wrap {
      grid-column: 2;
    }
  }

  /* 右侧 TOC */
  .sidebar-right {
    display: none;
  }

  /* 主内容区 */
  .post-main {
    max-width: 768px;
  }

  .back {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted-foreground);
    margin-bottom: 1.5rem;
    transition: color 0.15s ease;
  }

  .back:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .article-head {
    margin-bottom: 2rem;
  }

  .article-head h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0 0 0.75rem;
    color: var(--card-foreground);
  }

  .meta {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--muted-foreground);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .meta-sep {
    color: var(--text-400);
  }

  .updated {
    color: var(--muted-foreground);
  }

  .hero-img {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .pn-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.25rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .pn-link:hover {
    text-decoration: none;
    border-color: var(--brand-300);
    box-shadow: var(--shadow-sm);
  }

  .pn-link.older {
    text-align: right;
  }

  .pn-placeholder {
    visibility: hidden;
  }

  .pn-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .pn-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--card-foreground);
    line-height: 1.35;
  }

  /* 三栏布局:大屏显示 */
  @media (min-width: 1280px) {
    .post-layout {
      grid-template-columns: 200px minmax(0, 1fr) 200px;
    }

    .sidebar-left {
      display: block;
    }

    .sidebar-right {
      display: block;
    }

    .sidebar-right :global(.toc) {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
      max-height: calc(100vh - var(--header-height) - 3rem);
      overflow-y: auto;
    }

    .post-main {
      max-width: none;
    }
  }

  /* 中屏:两栏(左侧导航 + 正文) */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .post-layout {
      grid-template-columns: 200px minmax(0, 1fr);
    }

    .sidebar-left {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .post-layout {
      padding: 1.25rem 1rem 1rem;
      gap: 1.5rem;
    }

    .article-head {
      margin-bottom: 1.5rem;
    }

    .article-head h1 {
      font-size: 1.5rem;
    }

    .meta {
      font-size: 0.72rem;
      gap: 0.3rem;
    }

    .back {
      margin-bottom: 1.25rem;
    }

    .prev-next {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
    }

    .pn-link {
      padding: 0.9rem 1rem;
    }

    .pn-link.older {
      text-align: left;
    }

    .pn-placeholder {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .article-head h1 {
      font-size: 1.35rem;
    }

    /* 窄屏下代码块/表格字号略降，减少横向滚动需求 */
    .prose pre {
      font-size: 0.78rem;
    }
  }
</style>

<script>
  function initProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;
    const update = () => {
      const el = document.documentElement;
      const total = el.scrollHeight - el.clientHeight;
      const pct = total > 0 ? (el.scrollTop / total) * 100 : 0;
      bar.style.width = pct + '%';
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  initProgress();
</script>
