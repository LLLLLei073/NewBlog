---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Tag from '../components/Tag.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Heading = { depth: number; slug: string; text: string };
type Nav = { slug: string; title: string } | null;

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags: string[];
  headings?: Heading[];
  newer?: Nav;
  older?: Nav;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  headings = [],
  newer = null,
  older = null,
} = Astro.props;

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = toc.length > 1;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <article class="post">
    <a href="/blog" class="back">&larr; 返回文章列表</a>

    <header class="article-head">
      <h1>{title}</h1>
      <div class="meta">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span class="updated">
              · 更新于 <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <Tag tag={tag} />
            ))}
          </div>
        )
      }
    </header>

    {heroImage && <img src={heroImage} alt={title} class="hero-img" />}

    <div class:list={['post-body', { 'has-toc': hasToc }]}>
      {hasToc && <TableOfContents toc={toc} />}
      <div class="prose">
        <slot />
      </div>
    </div>

    {
      (newer || older) && (
        <nav class="prev-next" aria-label="文章导航">
          {newer ? (
            <a class="pn-link newer" href={`/blog/${newer.slug}/`}>
              <span class="pn-label">&larr; 上一篇</span>
              <span class="pn-title">{newer.title}</span>
            </a>
          ) : (
            <span class="pn-placeholder" />
          )}
          {older ? (
            <a class="pn-link older" href={`/blog/${older.slug}/`}>
              <span class="pn-label">下一篇 &rarr;</span>
              <span class="pn-title">{older.title}</span>
            </a>
          ) : (
            <span class="pn-placeholder" />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: 50;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0;
    background: var(--primary);
    transition: width 0.08s linear;
  }

  .post {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 1rem;
  }

  .back {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted-foreground);
    margin-bottom: 2rem;
    transition: color 0.15s ease;
  }

  .back:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .article-head {
    margin-bottom: 2rem;
  }

  .article-head h1 {
    font-size: 2.5rem;
    line-height: 1.15;
    margin: 0 0 1rem;
    color: var(--card-foreground);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted-foreground);
    margin-bottom: 0.75rem;
  }

  .updated {
    color: var(--muted-foreground);
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .hero-img {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .post-body {
    display: block;
  }

  .prose {
    max-width: 720px;
  }

  .post-body:not(.has-toc) .prose {
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .post-body.has-toc {
      display: grid;
      grid-template-columns: 220px minmax(0, 680px);
      gap: 2.5rem;
      align-items: start;
    }

    .post-body.has-toc :global(.toc) {
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }

    .post-body.has-toc .prose {
      max-width: none;
    }
  }

  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .pn-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    background: var(--popover);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .pn-link:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-400);
  }

  .pn-link.older {
    text-align: right;
  }

  .pn-placeholder {
    visibility: hidden;
  }

  .pn-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
  }

  .pn-title {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--card-foreground);
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .article-head h1 {
      font-size: 1.85rem;
    }
    .prev-next {
      grid-template-columns: 1fr;
    }
    .pn-link.older {
      text-align: left;
    }
    .pn-placeholder {
      display: none;
    }
  }
</style>

<script>
  function initProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;
    const update = () => {
      const el = document.documentElement;
      const total = el.scrollHeight - el.clientHeight;
      const pct = total > 0 ? (el.scrollTop / total) * 100 : 0;
      bar.style.width = pct + '%';
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  initProgress();
</script>
