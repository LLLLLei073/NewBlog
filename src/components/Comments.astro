---
/* GitHub Discussions 评论区（giscus）。
   前置条件：仓库已启用 Discussions，且已安装 giscus App（https://github.com/apps/giscus）。 */

const lightTheme = new URL('/giscus/light.css', Astro.site).href;
---

<section class="comments" aria-label="评论区">
  <h2 class="comments-title">评论</h2>

  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="LLLLLei073/NewBlog"
    data-repo-id="R_kgDOToND8g"
    data-category="General"
    data-category-id="DIC_kwDOToND8s4DCY0P"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme={lightTheme}
    data-lang="zh-CN"
    data-loading="lazy"
    async
  ></script>

  <noscript>
    <p class="comments-noscript">评论功能需要启用 JavaScript。你也可以直接在
      <a href="https://github.com/LLLLLei073/NewBlog/discussions" target="_blank" rel="noopener">GitHub Discussions</a>
      里参与讨论。</p>
  </noscript>
</section>

<style>
  .comments {
    /* 已包在 .comments-wrap 卡片内，不再需要大外边距和顶部边框 */
    padding-top: 0.25rem;
  }

  .comments-title {
    font-size: 1.25rem;
    margin: 0 0 1rem;
    /* 卡片固定白底，标题固定深色，亮暗模式下都可读 */
    color: #1a1e35;
  }

  .comments-noscript {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: #5b6172;
  }
</style>
