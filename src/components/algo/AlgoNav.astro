---
/**
 * 「演算手稿」专栏内部导航:右侧符号栏(λ/✎/⌖/Θ/搜索),
 * 悬浮显示具体名称;底部个人标记「F.」(→ /about);移动端收为
 * 顶部一条。符号用等宽字族的算法记号。
 */
import ColumnRail from '../ColumnRail.astro';

const path = Astro.url.pathname;
const is = {
  home: path === '/algorithm/' || path === '/algorithm',
  notes: path.startsWith('/algorithm/notes'),
  map: path.startsWith('/algorithm/map'),
  complexity: path.startsWith('/algorithm/complexity'),
};
const items = [
  { href: '/algorithm/', glyph: 'λ', label: '首页', active: is.home },
  { href: '/algorithm/notes/', glyph: '✎', label: '题解手记', active: is.notes },
  { href: '/algorithm/map/', glyph: '⌖', label: '知识地图', active: is.map },
  {
    href: '/algorithm/complexity/',
    glyph: 'Θ',
    label: '复杂度手册',
    active: is.complexity,
  },
];
---

<ColumnRail
  theme="algo"
  railLabel="演算手稿导航"
  brand={{ cn: '演算手稿', en: 'ALGORITHM NOTES' }}
  items={items}
  search={{ href: '/algorithm/notes/', label: '搜索手记' }}
>
  <a
    slot="utils"
    class="crail-item crail-mark"
    href="/about/"
    aria-label="关于我"
    data-label="关于我">F.</a
  >
  <a slot="panel-extra" class="crail-panel-link" href="/about/">
    <span class="crail-panel-glyph" aria-hidden="true">F.</span>
    关于我
  </a>
</ColumnRail>
