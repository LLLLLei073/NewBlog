---
interface Props {
  tag: string;
  size?: 'sm' | 'md';
}

const { tag, size = 'sm' } = Astro.props;
const href = `/tags/${encodeURIComponent(tag)}/`;
---

<a href={href} class:list={['tag', size]} aria-label={`查看标签「${tag}」的文章`}>#{tag}</a>

<style>
  .tag {
    font-family: var(--font-sans);
    font-weight: 500;
    line-height: 1.4;
    color: var(--brand-700);
    background: var(--brand-100);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-md);
    transition: background-color 0.15s ease, color 0.15s ease;
    display: inline-flex;
    align-items: center;
  }

  .tag:hover {
    color: var(--brand-700);
    background: var(--brand-200);
    text-decoration: none;
  }

  .tag.sm {
    font-size: 0.72rem;
  }

  .tag.md {
    font-size: 0.82rem;
    padding: 0.2rem 0.65rem;
  }

  :global(html[data-theme='dark']) .tag {
    color: var(--brand-300);
    background: var(--brand-100);
  }

  :global(html[data-theme='dark']) .tag:hover {
    background: var(--brand-200);
    color: var(--brand-300);
  }
</style>
