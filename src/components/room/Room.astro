---
import { ROOM_LINKS } from './config';
import { HOTSPOTS } from './activity';
import CoalAssistant from './CoalAssistant.astro';
---

<section class="room" aria-label="房间导航" data-room>
  <div
    class="room-stage"
    data-room-stage
    aria-label="窗边书房，少女与小煤球在这里活动"
  >
    <img
      class="room-background"
      data-room-placeholder
      src="/art/room/background.webp"
      width="1536"
      height="1024"
      alt="与首页相同的窗边书房，木桌、书架、植物和空闲的地面"
      fetchpriority="high"
    />
    <canvas data-room-canvas hidden aria-hidden="true"></canvas>
    <nav class="room-hotspots" aria-label="房间物品入口">
      {
        HOTSPOTS.map((point) => {
          const item = ROOM_LINKS.find((item) => item.id === point.id)!;
          return (
            <a
              href={item.href}
              style={`--x:${point.x * 100}%;--y:${point.y * 100}%`}
              aria-label={`${item.object} · ${item.label}`}
            >
              <span>
                {item.object} · {item.label}
              </span>
            </a>
          );
        })
      }
    </nav>
  </div>
  <CoalAssistant />
  <div class="room-controls">
    <p data-room-status role="status">在同一间书房里，慢慢待一会儿。</p>
    <div class="room-buttons">
      <button
        type="button"
        data-coal-open
        aria-controls="coal-panel"
        aria-expanded="false">找笔记</button
      >
      <label
        >台灯 <select data-room-lamp aria-label="书房台灯"
          ><option value="auto">跟随时间</option><option value="on">开</option
          ><option value="off">关</option></select
        ></label
      >
      <button type="button" data-room-motion aria-pressed="false" hidden
        >暂停动效</button
      >
    </div>
  </div>
  <nav class="room-links" aria-label="房间的备用栏目入口">
    {
      ROOM_LINKS.map((item) => (
        <a href={item.href} data-room-link={item.id}>
          <>
            <span>{item.label}</span>
            <small>{item.object}</small>
          </>
        </a>
      ))
    }
  </nav>
</section>
<script>
  import { mountRoomLife } from './life';
  const root = document.querySelector<HTMLElement>('[data-room]');
  if (root) mountRoomLife(root);
</script>
<style>
  .room {
    position: relative;
    --room-ink: #e9e5d7;
    --room-paper: #1f2929;
    --room-muted: #c1c8bd;
  }
  .room-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3/2;
    overflow: hidden;
    border-radius: 5px;
    background: #3c443e;
    isolation: isolate;
    touch-action: pan-y pinch-zoom;
  }
  .room-background,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  canvas[hidden] {
    display: none;
  }
  .room-hotspots {
    position: absolute;
    inset: 0;
  }
  .room-hotspots a {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    display: grid;
    place-items: center;
    text-decoration: none;
    color: #fff8e3;
    outline-offset: 2px;
  }
  .room-hotspots a::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff8e3;
    box-shadow:
      0 0 0 4px #20282050,
      0 0 12px #fff6;
  }
  .room-hotspots a span {
    position: absolute;
    bottom: 100%;
    white-space: nowrap;
    padding: 6px 9px;
    background: #192625ed;
    border: 1px solid #d3d9c533;
    font-size: 12px;
    opacity: 0;
    pointer-events: none;
    border-radius: 3px;
  }
  .room-hotspots a:hover span,
  .room-hotspots a:focus-visible span {
    opacity: 1;
  }
  .room-hotspots a:first-child span {
    right: 0;
  }
  .room-hotspots a:last-child span {
    left: 0;
  }
  .room-controls {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    padding: 18px 0;
    color: var(--room-muted);
    font-size: 12px;
  }
  .room-controls p {
    margin: 0;
    line-height: 1.8;
  }
  .room-buttons {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .room-buttons button,
  .room-buttons select {
    min-height: 44px;
    background: #263431;
    color: var(--room-ink);
    border: 1px solid #d2d7bc38;
    border-radius: 3px;
    padding: 0 12px;
    font: inherit;
    cursor: pointer;
  }
  .room-buttons label {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .room-buttons button:disabled {
    opacity: 0.7;
    cursor: default;
  }
  .room-links {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    border-block: 1px solid #d2d7bc30;
  }
  .room-links a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 76px;
    color: var(--room-ink);
    text-decoration: none;
    font-size: 13px;
  }
  .room-links small {
    font-size: 10px;
    color: var(--room-muted);
  }
  .room-links a:hover,
  .room-links a:focus-visible {
    background: #ffffff0d;
  }
  @media (max-width: 700px) {
    .room-controls {
      align-items: flex-start;
      flex-direction: column;
    }
    .room-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .room-hotspots {
      display: none;
    }
    .room-buttons {
      gap: 8px;
    }
    .room-buttons button,
    .room-buttons select {
      padding: 0 9px;
    }
  }
</style>
