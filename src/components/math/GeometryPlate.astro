---
/**
 * 「形与数」定理图版:单位圆 → 正弦曲线的经典构造。
 * 纯内联 SVG,几何量在构建期算出;stroke 元素带 data-mt-draw,
 * 开屏时逐条绘制,平时作为静态展品。
 */
const CX = 130;
const CY = 150;
const R = 78;
const TH = (55 * Math.PI) / 180; // 展示角 θ
const px = CX + R * Math.cos(TH);
const py = CY - R * Math.sin(TH);

/* 正弦图:x 从 210 起,一个周期 140px,振幅 24 */
const SX0 = 210;
const PER = 140;
const AMP = 24;
const BASE = 218;
const phaseOf = (x: number) => ((x - SX0) / PER) * Math.PI * 2;
const xs = SX0 + (TH / (Math.PI * 2)) * PER;
const sy = BASE - AMP * Math.sin(TH);

const sinePts: string[] = [];
for (let x = 0; x <= 150; x += 3) {
  const X = SX0 + x;
  const Y = BASE - AMP * Math.sin(phaseOf(X));
  sinePts.push(`${x === 0 ? 'M' : 'L'}${X.toFixed(1)} ${Y.toFixed(1)}`);
}
const sinePath = sinePts.join(' ');

/* 半径与正弦点之间的投影虚线(静态辅助线) */
const projH = `M${px.toFixed(1)} ${py.toFixed(1)} H${xs.toFixed(1)}`;
const projV = `M${xs.toFixed(1)} ${py.toFixed(1)} V${sy.toFixed(1)}`;

/* 角度小弧 */
const arcR = 22;
const ax = CX + arcR * Math.cos(TH);
const ay = CY - arcR * Math.sin(TH);
const arcD = `M${CX + arcR} ${CY} A${arcR} ${arcR} 0 0 0 ${ax.toFixed(1)} ${ay.toFixed(1)}`;
---

<svg
  class="geometry-plate"
  viewBox="0 0 370 260"
  fill="none"
  aria-hidden="true"
>
  <!-- 坐标轴 -->
  <line
    data-mt-draw
    x1="24"
    y1={BASE}
    x2="352"
    y2={BASE}
    stroke="currentColor"
    stroke-width="1"
    opacity="0.45"></line>
  <line
    data-mt-draw
    x1={CX}
    y1="34"
    x2={CX}
    y2="244"
    stroke="currentColor"
    stroke-width="1"
    opacity="0.45"></line>

  <!-- 单位圆与半径 -->
  <circle
    data-mt-draw
    cx={CX}
    cy={CY}
    r={R}
    stroke="currentColor"
    stroke-width="1.6"></circle>
  <line
    data-mt-draw
    x1={CX}
    y1={CY}
    x2={px.toFixed(1)}
    y2={py.toFixed(1)}
    stroke="var(--math-vermilion, #b23a2e)"
    stroke-width="1.6"></line>
  <path
    data-mt-draw
    d={arcD}
    stroke="var(--math-vermilion, #b23a2e)"
    stroke-width="1.2"></path>

  <!-- 投影虚线:圆上的点 → 正弦曲线 -->
  <path
    d={projH}
    stroke="var(--math-vermilion, #b23a2e)"
    stroke-width="1"
    stroke-dasharray="3 4"
    opacity="0.6"></path>
  <path
    d={projV}
    stroke="var(--math-vermilion, #b23a2e)"
    stroke-width="1"
    stroke-dasharray="3 4"
    opacity="0.6"></path>

  <!-- 正弦曲线 -->
  <path
    data-mt-draw
    d={sinePath}
    stroke="var(--primary, #31469e)"
    stroke-width="1.8"
    stroke-linecap="round"></path>

  <!-- 关键点 -->
  <circle cx={CX} cy={CY} r="2.4" fill="currentColor"></circle>
  <circle
    cx={px.toFixed(1)}
    cy={py.toFixed(1)}
    r="3"
    fill="var(--math-vermilion, #b23a2e)"></circle>
  <circle
    cx={xs.toFixed(1)}
    cy={sy.toFixed(1)}
    r="3"
    fill="var(--primary, #31469e)"></circle>

  <!-- θ 标注 -->
  <text
    x={CX + 30}
    y={CY - 12}
    font-size="12"
    font-style="italic"
    fill="currentColor"
    opacity="0.7">θ</text
  >
</svg>

<style>
  .geometry-plate {
    display: block;
    width: 100%;
    height: auto;
    color: var(--foreground);
  }
</style>
