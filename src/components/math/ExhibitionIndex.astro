---
/**
 * 首屏底部横向展览索引:竖向细线分隔,不用独立卡片。
 * 每项:大编号 / 中文标题 + 英文小标 / 一句说明 / 文章数 / 缩略图 / 箭头。
 */
import { EXHIBITS } from '../../data/math/column.ts';
import MathFigure from './MathFigure.astro';
---

<section class="ex-index" aria-label="展览索引">
  <ol>
    {
      EXHIBITS.map((e) => (
        <li>
          <a href={e.href} class="ex-row">
            <span class="ex-no" aria-hidden="true">
              {e.no}
            </span>
            <span class="ex-head">
              <span class="ex-title">{e.title}</span>
              <span class="mono-label">{e.en}</span>
            </span>
            <span class="ex-desc">{e.desc}</span>
            <span class="ex-count">
              {e.count > 0 ? `${e.count} 篇手记` : '整理中'}
            </span>
            <span class="ex-thumb" aria-hidden="true">
              <MathFigure kind={e.thumb} />
            </span>
            <span class="ex-arrow" aria-hidden="true">
              <svg
                width="22"
                height="10"
                viewBox="0 0 22 10"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              >
                <line x1="1" y1="5" x2="19" y2="5" />
                <polyline points="15,1 20,5 15,9" fill="none" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .ex-index {
    border-top: 1px solid var(--math-divider);
    margin-top: clamp(1rem, 3vw, 2rem);
  }
  .ex-index ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ex-index li + li {
    border-left: 1px solid var(--math-divider);
  }

  .ex-row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 92px;
    grid-template-rows: auto auto auto;
    column-gap: 1rem;
    align-items: start;
    padding: 1.4rem 1.3rem 1.5rem;
    color: inherit;
    text-decoration: none;
    min-height: 44px;
    transition: background-color 0.2s ease;
  }
  .ex-row:hover {
    background: var(--accent);
  }

  .ex-no {
    grid-row: 1 / 4;
    align-self: start;
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 30px;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }
  .ex-row:hover .ex-no {
    color: var(--primary);
  }
  .ex-head {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    min-width: 0;
  }
  .ex-title {
    font-family: var(--font-hei);
    font-weight: 300;
    font-size: 21px;
    letter-spacing: 0.06em;
    color: var(--foreground);
  }
  .ex-desc {
    margin-top: 0.3rem;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--muted-foreground);
  }
  .ex-count {
    margin-top: 0.55rem;
    font-size: 12px;
    color: var(--muted-foreground);
    opacity: 0.85;
  }
  .ex-thumb {
    grid-row: 1 / 4;
    grid-column: 3;
    width: 92px;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }
  .ex-row:hover .ex-thumb {
    opacity: 1;
  }
  .ex-thumb :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .ex-arrow {
    position: absolute;
    right: 1.2rem;
    bottom: 1.1rem;
    color: var(--primary);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .ex-row:hover .ex-arrow,
  .ex-row:focus-visible .ex-arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 900px) {
    .ex-index ol {
      grid-template-columns: 1fr;
    }
    .ex-index li + li {
      border-left: 0;
      border-top: 1px solid var(--math-divider);
    }
    .ex-thumb {
      width: 84px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ex-arrow,
    .ex-thumb,
    .ex-row {
      transition: none;
    }
  }
</style>
