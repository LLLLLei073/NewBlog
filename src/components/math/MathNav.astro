---
/**
 * 「形与数」专栏内部导航:展墙细线,当前项群青下划线;
 * 右侧图鉴标记「F.」(→ /about)。
 */
const path = Astro.url.pathname;
const is = {
  home: path === '/math/' || path === '/math',
  notes: path.startsWith('/math/notes'),
};
const items = [
  { href: '/math/', no: 'Ⅰ', label: '首页', active: is.home },
  { href: '/math/notes/', no: 'Ⅱ', label: '手记图版', active: is.notes },
];
---

<nav class="math-nav" aria-label="专栏导航">
  <div class="math">
    <div class="links">
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={['nav-item', { active: item.active }]}
            aria-current={item.active ? 'page' : undefined}
          >
            <span class="no" aria-hidden="true">{item.no}</span>
            {item.label}
          </a>
        ))
      }
    </div>
    <a href="/about/" class="mark" title="关于我">F.</a>
  </div>
</nav>

<style>
  .math-nav {
    border-bottom: 1px solid var(--border);
    margin-top: clamp(0.75rem, 2vw, 1.25rem);
  }
  .math-nav .math {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .links {
    display: flex;
    gap: clamp(1.1rem, 3vw, 2rem);
    overflow-x: auto;
  }
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    padding: 0.55rem 0 0.7rem;
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
    transition: color 0.18s ease;
  }
  .nav-item .no {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--math-vermilion);
    opacity: 0.75;
  }
  .nav-item::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 2px;
    background: var(--primary);
    transition: width 0.22s ease;
  }
  .nav-item:hover {
    color: var(--foreground);
  }
  .nav-item.active {
    color: var(--primary);
  }
  .nav-item.active::after {
    width: 1.6em;
  }
  .mark {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--foreground);
    text-decoration: none;
  }
  .mark:hover {
    color: var(--primary);
  }
</style>
