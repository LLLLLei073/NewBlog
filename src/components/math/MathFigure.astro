---
/**
 * 观象台极简几何图形:构建期算好点集,输出纤细线条 SVG。
 * 线条用 var(--math-line),强调用 var(--primary),问题位用
 * var(--math-coral),随专栏令牌自动适配高对比度模式。
 * 提供 alt 时作为 role="img" 图形,否则纯装饰。
 */
interface Props {
  kind:
    | 'torus'
    | 'unitcircle'
    | 'series'
    | 'spiral'
    | 'riemann'
    | 'grid'
    | 'sqrt2'
    | 'primes'
    | 'ladder'
    | 'basel';
  alt?: string;
  class?: string;
}

const { kind, alt, class: className } = Astro.props;
const L = 'var(--math-line)';
const P = 'var(--primary)';
const C = 'var(--math-coral)';
const S = `fill="none" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"`;

/* 方形螺旋:边长逐次收缩,隐喻数列收敛 */
const spiralPts = (() => {
  let x = 26;
  let y = 74;
  let len = 68;
  const dirs = [
    [1, 0],
    [0, -1],
    [-1, 0],
    [0, 1],
  ];
  const pts = [`${x},${y}`];
  for (let i = 0; i < 11; i++) {
    const [dx, dy] = dirs[i % 4]!;
    x += dx * len;
    y += dy * len;
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
    len *= 0.82;
  }
  return pts.join(' ');
})();

/* 无穷级数:点列沿对数螺线收拢到一个极限点 */
const seriesDots = (() => {
  const cx = 62;
  const cy = 45;
  let r = 34;
  let a = 0.6;
  const dots: string[] = [];
  const line: string[] = [];
  for (let n = 0; n < 9; n++) {
    const px = cx + r * Math.cos(a);
    const py = cy - r * Math.sin(a);
    dots.push(
      `<circle cx="${px.toFixed(1)}" cy="${py.toFixed(1)}" r="1.6" fill="${L}" stroke="none" opacity="${(1 - n * 0.07).toFixed(2)}"/>`,
    );
    line.push(`${px.toFixed(1)},${py.toFixed(1)}`);
    r *= 0.72;
    a += 2.5;
  }
  return (
    `<polyline points="${line.join(' ')}" ${S} stroke="${L}" stroke-width="0.8" opacity="0.5"/>` +
    dots.join('') +
    `<circle cx="${cx}" cy="${cy}" r="2.6" fill="${P}" stroke="none"/>`
  );
})();

const FIGURES: Record<Props['kind'], string> = {
  torus: `
    <ellipse cx="60" cy="45" rx="46" ry="27" ${S} stroke="${L}"/>
    <ellipse cx="60" cy="45" rx="17" ry="9" ${S} stroke="${L}"/>
    <path d="M 14,45 Q 60,10 106,45" ${S} stroke="${L}" opacity="0.7"/>
    <path d="M 14,45 Q 60,80 106,45" ${S} stroke="${L}" opacity="0.7"/>
    <ellipse cx="60" cy="45" rx="46" ry="27" ${S} stroke="${L}" opacity="0.45" transform="rotate(32 60 45)"/>
    <ellipse cx="60" cy="45" rx="46" ry="27" ${S} stroke="${L}" opacity="0.45" transform="rotate(-32 60 45)"/>
  `,
  unitcircle: `
    <line x1="14" y1="45" x2="106" y2="45" stroke="${L}" stroke-width="1"/>
    <line x1="60" y1="9" x2="60" y2="81" stroke="${L}" stroke-width="1"/>
    <circle cx="60" cy="45" r="30" ${S} stroke="${L}"/>
    <line x1="60" y1="45" x2="83" y2="25.7" ${S} stroke="${P}"/>
    <path d="M 70,45 A 10,10 0 0 0 67.7,38.6" ${S} stroke="${P}" stroke-width="1"/>
    <line x1="83" y1="25.7" x2="83" y2="45" stroke="${L}" stroke-width="0.9" stroke-dasharray="3 3"/>
    <line x1="83" y1="25.7" x2="60" y2="25.7" stroke="${L}" stroke-width="0.9" stroke-dasharray="3 3"/>
    <circle cx="83" cy="25.7" r="2.2" fill="${P}" stroke="none"/>
  `,
  series: seriesDots,
  spiral: `
    <polyline points="${spiralPts}" ${S} stroke="${L}"/>
    <circle cx="60.6" cy="46.2" r="2.4" fill="${P}" stroke="none"/>
  `,
  riemann: `
    <line x1="14" y1="72" x2="108" y2="72" stroke="${L}" stroke-width="1"/>
    <line x1="28" y1="10" x2="28" y2="76" stroke="${L}" stroke-width="1"/>
    <path d="M28,66 C 52,60 76,44 104,18" ${S} stroke="${P}" stroke-width="1.3"/>
    ${[30, 40, 50, 60, 70, 80, 90]
      .map(
        (x, i) =>
          `<rect x="${x}" y="${[24, 30, 36, 42, 49, 55, 60][i]}" width="9" height="${72 - [24, 30, 36, 42, 49, 55, 60][i]!}" ${S} stroke="${L}" opacity="0.8"/>`,
      )
      .join('')}
  `,
  grid: `
    ${[20, 36, 52, 68, 84, 100]
      .map((x) => `<line x1="${x}" y1="13" x2="${x}" y2="77" stroke="${L}" stroke-width="0.7" opacity="0.55"/>`)
      .join('')}
    ${[13, 29, 45, 61, 77]
      .map((y) => `<line x1="20" y1="${y}" x2="100" y2="${y}" stroke="${L}" stroke-width="0.7" opacity="0.55"/>`)
      .join('')}
    <path d="M62.2,53 L96.2,44 L107,18.8 L73,27.8 Z" ${S} stroke="${P}" stroke-width="1.3"/>
    <line x1="62.2" y1="53" x2="96.2" y2="44" ${S} stroke="${P}"/>
    <line x1="62.2" y1="53" x2="73" y2="27.8" ${S} stroke="${C}"/>
  `,
  sqrt2: `
    <rect x="30" y="15" width="60" height="60" ${S} stroke="${L}"/>
    <line x1="30" y1="75" x2="90" y2="15" ${S} stroke="${P}"/>
    <path d="M 82,75 L 82,67 L 90,67" ${S} stroke="${L}" stroke-width="1"/>
  `,
  primes: `
    <line x1="14" y1="52" x2="106" y2="52" stroke="${L}" stroke-width="1"/>
    ${[22, 30, 38, 46, 54, 62, 70, 78, 86, 94, 102]
      .map(
        (x, i) =>
          `<line x1="${x}" y1="${[30, 38, 54, 70, 102].includes(x) ? 40 : 47}" x2="${x}" y2="52" stroke="${L}" stroke-width="1"/>${[30, 38, 54, 70, 102].includes(x) ? `<circle cx="${x}" cy="${36 - (i % 3) * 4}" r="1.7" fill="${P}" stroke="none"/>` : ''}`,
      )
      .join('')}
    <path d="M 96,26 L 104,30 L 104,34" ${S} stroke="${L}" stroke-width="1"/>
  `,
  ladder: `
    <line x1="14" y1="72" x2="106" y2="72" stroke="${L}" stroke-width="1"/>
    ${[0, 1, 2, 3, 4, 5]
      .map(
        (k) =>
          `<rect x="${22 + 13 * k}" y="${62 - 9 * k}" width="9" height="${10 + 9 * k}" ${S} stroke="${L}" opacity="0.85"/>`,
      )
      .join('')}
    <line x1="22" y1="62" x2="87" y2="17" ${S} stroke="${P}" stroke-width="1.1" stroke-dasharray="4 3"/>
  `,
  basel: `
    <line x1="16" y1="70" x2="104" y2="70" stroke="${L}" stroke-width="1"/>
    <path d="M 16,70 A 44,44 0 0 1 104,70" ${S} stroke="${P}" stroke-width="1.2"/>
    <path d="M 16,70 A 22,22 0 0 1 60,70" ${S} stroke="${L}"/>
    <path d="M 60,70 A 22,22 0 0 1 104,70" ${S} stroke="${L}"/>
    <path d="M 38,70 A 11,11 0 0 1 60,70" ${S} stroke="${L}" opacity="0.6"/>
    <path d="M 60,70 A 11,11 0 0 1 82,70" ${S} stroke="${L}" opacity="0.6"/>
    <path d="M 82,70 A 11,11 0 0 1 104,70" ${S} stroke="${L}" opacity="0.6"/>
  `,
};
---

<svg
  viewBox="0 0 120 90"
  class={className}
  role={alt ? 'img' : undefined}
  aria-hidden={alt ? undefined : 'true'}
  focusable="false"
>
  {alt ? <title>{alt}</title> : null}
  <g set:html={FIGURES[kind]} />
</svg>
