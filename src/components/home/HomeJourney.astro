---
import { CATEGORIES } from '../../utils/categories.ts';

const chapterCopy: Record<(typeof CATEGORIES)[number]['id'], string> = {
  algorithm: '刷题、数据结构，还有做题时卡住又想明白的过程。',
  math: '高等数学、线性代数和概率论，记下课堂之外的理解。',
  music: '听到喜欢的声音，也试着弄懂乐理、编曲和演奏。',
  game: '玩游戏，也关心它们怎样被设计、开发和讲述。',
  others: '项目记录、日常折腾，以及暂时放不进其他栏目的想法。',
};
---

<div class="home-journey" data-home-journey>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="hero-kicker">欢迎来坐坐</p>
      <h1 id="home-title">你好，<span>我是徐磊。</span></h1>
      <p class="hero-intro">一名正在学习、写代码，也把笔记放在这里的大学生。</p>
    </div>
    <svg class="hero-line" viewBox="0 0 520 170" aria-hidden="true">
      <path d="M7 112C92 25 193 29 253 93c50 53 114 75 259 4"></path>
      <path d="M25 139c83-39 144-35 202 4 57 38 127 31 247-15"></path>
    </svg>
    <p class="scroll-note"><span aria-hidden="true">↓</span> 往下看看</p>
  </section>

  <div class="chapters" aria-label="栏目介绍">
    {
      CATEGORIES.map((category, index) => (
        <section
          class:list={['home-chapter', `chapter-${category.id}`]}
          data-reveal
          data-home-chapter={category.id}
        >
          <div class="chapter-number">{String(index + 1).padStart(2, '0')}</div>
          <div class="chapter-copy">
            <p>我在写</p>
            <h2>{category.label}</h2>
            <p class="chapter-description">{chapterCopy[category.id]}</p>
          </div>
          <div class="chapter-drawing" aria-hidden="true">
            {category.id === 'algorithm' && (
              <svg viewBox="0 0 320 240">
                <rect x="53" y="36" width="214" height="135" rx="5" />
                <path d="M33 196h254M126 171l-8 25m76-25 8 25" />
                <path d="m113 91-25 18 25 18m94-36 25 18-25 18m-66 16 35-70" />
              </svg>
            )}
            {category.id === 'math' && (
              <svg viewBox="0 0 320 240">
                <path d="M43 57c45-18 83-10 117 19v128c-34-29-72-37-117-19z" />
                <path d="M277 57c-45-18-83-10-117 19v128c34-29 72-37 117-19z" />
                <path d="M76 101h50m-50 24h61m48-24h60m-60 24h45" />
              </svg>
            )}
            {category.id === 'music' && (
              <svg viewBox="0 0 320 240">
                <circle cx="159" cy="139" r="67" />
                <circle cx="159" cy="139" r="15" />
                <path d="M78 53h166v32H78zm128 32-31 45m69-61 28 26m-23-4-20 50" />
              </svg>
            )}
            {category.id === 'game' && (
              <svg viewBox="0 0 320 240">
                <path d="M79 101c-20 3-37 40-43 74-5 28 18 35 37 13l31-36h112l31 36c19 22 42 15 37-13-6-34-23-71-43-74-43-7-119-7-162 0Z" />
                <path d="M89 118v43m-21-22h43m102-8h1m25 19h1" />
              </svg>
            )}
            {category.id === 'others' && (
              <svg viewBox="0 0 320 240">
                <path d="M57 57h206v145H57zM44 37h232v40H44z" />
                <path d="M125 111h70m-84 36h98" />
              </svg>
            )}
          </div>
        </section>
      ))
    }
  </div>
</div>

<style>
  .home-journey {
    color: var(--foreground);
  }

  .home-hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(5rem, 12vw, 9rem) 1.5rem 7rem;
    text-align: center;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }

  .hero-kicker,
  .chapter-copy > p:first-child {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--primary);
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 9vw, 8.5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  h1 span {
    white-space: nowrap;
  }

  .hero-intro {
    max-width: 580px;
    margin: clamp(1.8rem, 4vw, 3rem) auto 0;
    color: var(--muted-foreground);
    font-size: clamp(0.95rem, 1.6vw, 1.12rem);
    line-height: 1.9;
  }

  .hero-line {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: min(720px, 78vw);
    transform: translateX(-50%) rotate(-3deg);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    opacity: 0.17;
  }

  .hero-line path {
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: draw-line 1.8s 0.35s ease-out forwards;
  }

  .scroll-note {
    position: absolute;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    left: 50%;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transform: translateX(-50%);
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.72rem;
  }

  .scroll-note span {
    animation: nudge 1.8s ease-in-out 3;
  }

  .chapters {
    width: min(1160px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .home-chapter {
    min-height: min(760px, 88svh);
    display: grid;
    grid-template-columns: 80px minmax(240px, 0.82fr) minmax(320px, 1.18fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: center;
    padding: clamp(5rem, 11vw, 9rem) 0;
    border-top: 1px solid color-mix(in srgb, var(--foreground) 22%, transparent);
  }

  .home-chapter:nth-child(even) .chapter-copy {
    order: 3;
  }

  .home-chapter:nth-child(even) .chapter-drawing {
    order: 2;
  }

  .chapter-number {
    align-self: start;
    padding-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--primary);
  }

  .chapter-copy h2 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.8rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .chapter-description {
    max-width: 430px;
    margin: 2rem 0 0;
    color: var(--muted-foreground);
    line-height: 1.9;
  }

  .chapter-drawing {
    min-width: 0;
  }

  .chapter-drawing svg {
    display: block;
    width: 100%;
    max-height: 430px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
  }

  :global(html[data-home-enhanced='true']) [data-reveal] {
    opacity: 0;
    transform: translateY(42px);
    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(html[data-home-enhanced='true']) [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @keyframes draw-line {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }

  @media (max-width: 760px) {
    .home-hero {
      padding-inline: 1rem;
    }

    h1 {
      font-size: clamp(3rem, 17vw, 5.2rem);
    }

    .chapters {
      width: calc(100% - 2rem);
    }

    .home-chapter {
      min-height: auto;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 1rem;
      padding: 6rem 0;
    }

    .chapter-copy,
    .home-chapter:nth-child(even) .chapter-copy {
      order: 1;
      grid-column: 2;
    }

    .chapter-number {
      grid-column: 1;
      grid-row: 1;
    }

    .chapter-drawing,
    .home-chapter:nth-child(even) .chapter-drawing {
      order: 2;
      grid-column: 1 / -1;
      width: min(100%, 470px);
      margin: 2rem auto 0;
    }

    .chapter-copy h2 {
      font-size: clamp(3.5rem, 21vw, 6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line path,
    .scroll-note span {
      animation: none;
      stroke-dashoffset: 0;
    }

    :global(html[data-home-enhanced='true']) [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initHomeJourney() {
    const root = document.querySelector('[data-home-journey]');
    if (!root) return;
    document.documentElement.dataset.homeEnhanced = 'true';
    const sections = Array.from(root.querySelectorAll('[data-reveal]'));
    if (!('IntersectionObserver' in window)) {
      sections.forEach((section) => section.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
    );
    sections.forEach((section) => observer.observe(section));
    window.addEventListener(
      'pagehide',
      () => {
        observer.disconnect();
        sections.forEach((section) => section.classList.add('is-visible'));
      },
      { once: true },
    );
  }

  initHomeJourney();
</script>
