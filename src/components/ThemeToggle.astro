---
/* 主题切换按钮 — 纯客户端交互
   行为：
   - 单击主题按钮 → 浅色 ↔ 暗色（圆形扩散动画）
   - 暗色模式下，旁边出现"星星"小按钮 → 切换星空背景 / 极简纯色
   - 偏好（主题 + 暗色变体）写入 localStorage */
---

<div class="theme-controls">
  <button
    id="theme-toggle"
    type="button"
    aria-label="切换深色/浅色主题"
    title="切换主题"
  >
    <svg
      class="icon-sun"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
    <svg
      class="icon-moon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </button>
  <button
    id="dark-variant-toggle"
    type="button"
    class="dark-variant"
    aria-label="切换暗色变体"
    title="切换暗色变体（星空 / 极简）"
    hidden
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="currentColor"
      stroke="none"
    >
      <path
        d="M12 2l1.9 5.9L20 9.7l-4.6 3.8L17 19.5 12 16.3 7 19.5l1.6-6L4 9.7l6.1-1.8z"
      ></path>
    </svg>
  </button>
</div>

<style>
  .theme-controls {
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
  }

  #theme-toggle,
  .dark-variant {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--popover);
    color: var(--muted-foreground);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  #theme-toggle:hover,
  .dark-variant:hover {
    background: var(--muted);
    color: var(--foreground);
  }

  #theme-toggle:active,
  .dark-variant:active {
    transform: scale(0.9);
  }

  #theme-toggle:focus-visible,
  .dark-variant:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  /* 默认浅色：显示月亮图标（点击可切到深色） */
  .icon-moon {
    display: block;
  }
  .icon-sun {
    display: none;
  }

  /* 深色模式下：显示太阳图标（点击可切回浅色） */
  :global(html[data-theme='dark']) .icon-moon {
    display: none;
  }
  :global(html[data-theme='dark']) .icon-sun {
    display: block;
  }

  /* 极简暗色变体：星星按钮半透明，提示当前非默认 */
  :global(html[data-theme='dark'][data-dark-variant='minimal']) .dark-variant {
    color: var(--muted-foreground);
    opacity: 0.5;
  }
</style>

<script>
  import { setSiteTheme } from '../utils/theme';
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    const variantBtn = document.getElementById('dark-variant-toggle');
    if (!btn || !variantBtn) return;

    const root = document.documentElement;

    function syncVariantVisibility() {
      const isDark = root.getAttribute('data-theme') === 'dark';
      variantBtn!.hidden = !isDark;
    }

    function apply(theme: 'light' | 'dark', x?: number, y?: number) {
      const set = () => {
        setSiteTheme(theme);
        syncVariantVisibility();
      };

      if (
        document.startViewTransition &&
        !document.body.hasAttribute('data-room-home') &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        x !== undefined &&
        y !== undefined
      ) {
        root.style.setProperty('--vt-x', `${x}px`);
        root.style.setProperty('--vt-y', `${y}px`);
        document.startViewTransition(set);
      } else {
        set();
      }
    }

    btn.addEventListener('click', (e) => {
      const current = root.getAttribute('data-theme');
      const next: 'light' | 'dark' = current === 'dark' ? 'light' : 'dark';
      const rect = btn.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      apply(next, x, y);
    });

    variantBtn.addEventListener('click', () => {
      if (root.getAttribute('data-theme') !== 'dark') return;
      const cur = root.getAttribute('data-dark-variant') || 'starfield';
      const next = cur === 'starfield' ? 'minimal' : 'starfield';
      root.setAttribute('data-dark-variant', next);
      try {
        localStorage.setItem('dark-variant', next);
      } catch {}
    });

    // 初始化：让服务器渲的 hidden 状态跟实际主题保持一致
    syncVariantVisibility();
    new MutationObserver(syncVariantVisibility).observe(root, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }

  initThemeToggle();
</script>
