---
/* 主题切换按钮 — 纯客户端交互 */
---

<button id="theme-toggle" type="button" aria-label="切换深色/浅色主题" title="切换主题">
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<style>
  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--popover);
    color: var(--muted-foreground);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  #theme-toggle:hover {
    background: var(--muted);
    color: var(--foreground);
  }

  #theme-toggle:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  /* 默认浅色：显示月亮图标（点击可切到深色） */
  .icon-moon { display: block; }
  .icon-sun  { display: none; }

  /* 深色模式下：显示太阳图标（点击可切回浅色） */
  :global(html[data-theme="dark"]) .icon-moon { display: none; }
  :global(html[data-theme="dark"]) .icon-sun  { display: block; }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const root = document.documentElement;

    function apply(theme: 'light' | 'dark') {
      root.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
    }

    btn.addEventListener('click', () => {
      const current = root.getAttribute('data-theme');
      apply(current === 'dark' ? 'light' : 'dark');
    });
  }

  // 支持页面导航后重新绑定（Astro View Transitions）
  document.addEventListener('astro:after-swap', initThemeToggle);
  initThemeToggle();
</script>
