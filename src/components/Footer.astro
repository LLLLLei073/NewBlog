---
import { SITE_AUTHOR } from '../consts.ts';

interface Props {
  immersiveHome?: boolean;
}

const { immersiveHome = false } = Astro.props;
---

{
  !immersiveHome && (
    <footer>
      <div class="container">
        <nav class="footer-nav" aria-label="页脚导航">
          <a href="/archives">归档</a>
          <a href="/friends">友情链接</a>
          <a href="/about">关于</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p>
          &copy; {new Date().getFullYear()} {SITE_AUTHOR}. 保留所有权利。
        </p>
        <p>
          使用{' '}
          <a href="https://astro.build" target="_blank" rel="noopener">
            Astro
          </a>{' '}
          构建 · 部署在{' '}
          <a href="https://pages.github.com" target="_blank" rel="noopener">
            GitHub Pages
          </a>
        </p>
      </div>
    </footer>
  )
}

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: 3rem;
    text-align: center;
    color: var(--muted-foreground);
    font-size: 0.8rem;
  }

  footer p {
    margin: 0.35rem 0;
  }

  footer a {
    color: var(--muted-foreground);
  }

  footer a:hover {
    color: var(--primary);
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .footer-nav a {
    font-size: 0.78rem;
  }
</style>
