---
import { SITE_TITLE } from '../consts.ts';
import ThemeToggle from './ThemeToggle.astro';
import { CATEGORIES } from '../utils/categories.ts';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};

const navItems = [
  { href: '/', label: '首页' },
  ...CATEGORIES.map((c) => ({ href: c.path, label: c.label })),
  { href: '/blog', label: '文章' },
  { href: '/about', label: '关于' },
];
---

<header>
  <nav class="header-inner container-wide" aria-label="主导航">
    <div class="left">
      <a href="/" class="brand">{SITE_TITLE}</a>
      <div class="nav-links">
        {
          navItems.map((item) => (
            <a href={item.href} class:list={[isActive(item.href) ? 'active' : '']}>
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="right">
      <a href="/rss.xml" class="rss-link" title="RSS">RSS</a>
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        class="menu-toggle"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </nav>

  <!-- 移动端抽屉菜单 -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner container-wide">
      <ul class="mobile-nav">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['mobile-link', isActive(item.href) ? 'active' : '']}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/rss.xml" class="mobile-rss">RSS 订阅</a>
    </div>
  </div>
  <div id="menu-overlay" class="menu-overlay" hidden></div>
</header>

<style>
  header {
    height: var(--header-height);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 40;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--card-foreground);
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--card-foreground);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
  }

  .nav-links a {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted-foreground);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .nav-links a:hover {
    background: var(--muted);
    color: var(--foreground);
    text-decoration: none;
  }

  .nav-links a.active {
    background: var(--brand-100);
    color: var(--brand-700);
  }

  :global(html[data-theme='dark']) .nav-links a.active {
    background: var(--brand-100);
    color: var(--brand-300);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .rss-link {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted-foreground);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .rss-link:hover {
    background: var(--muted);
    color: var(--foreground);
    text-decoration: none;
  }

  /* 汉堡按钮：桌面端隐藏 */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--popover);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .menu-toggle:hover {
    background: var(--muted);
  }

  .menu-bar {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--muted-foreground);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* 打开态：三条线变 X */
  .menu-toggle[aria-expanded='true'] .menu-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* 移动端抽屉 */
  .mobile-menu {
    display: none;
  }

  .menu-overlay {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .mobile-menu {
      display: block;
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      z-index: 39;
      background: var(--header-bg);
      backdrop-filter: blur(16px) saturate(140%);
      -webkit-backdrop-filter: blur(16px) saturate(140%);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.2s ease, opacity 0.2s ease, visibility 0.2s;
    }

    .mobile-menu.open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .mobile-menu-inner {
      padding: 0.75rem 1.5rem 1.25rem;
    }

    .mobile-nav {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.4rem;
    }

    .mobile-link {
      display: flex;
      align-items: center;
      min-height: 46px; /* 触控目标 ≥44px */
      padding: 0 0.9rem;
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--muted-foreground);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: var(--card);
      transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

    .mobile-link:hover {
      background: var(--muted);
      color: var(--foreground);
      text-decoration: none;
    }

    .mobile-link.active {
      background: var(--brand-100);
      border-color: var(--brand-300);
      color: var(--brand-700);
    }

    :global(html[data-theme='dark']) .mobile-link.active {
      color: var(--brand-300);
    }

    .mobile-rss {
      display: inline-flex;
      align-items: center;
      margin-top: 0.75rem;
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--muted-foreground);
      padding: 0.55rem 0.9rem;
      border-radius: var(--radius-md);
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .mobile-rss:hover {
      background: var(--muted);
      color: var(--foreground);
      text-decoration: none;
    }
  }

  @media (max-width: 480px) {
    .mobile-nav {
      grid-template-columns: 1fr; /* 超窄屏单列，触控目标更大 */
    }
  }

  @media (min-width: 769px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      menu.classList.toggle('open', open);
      menu.setAttribute('aria-hidden', String(!open));
      document.body.style.overflow = open ? 'hidden' : '';
    };

    btn.addEventListener('click', () => {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    // 点击菜单内的链接后自动关闭
    menu.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;
      if (target.closest('a')) setOpen(false);
    });

    // ESC 关闭
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') setOpen(false);
    });

    // 视口从移动端变宽时复位
    const mq = window.matchMedia('(min-width: 769px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // 支持页面导航后重新绑定（Astro View Transitions）
  document.addEventListener('astro:after-swap', initMobileMenu);
  initMobileMenu();
</script>
