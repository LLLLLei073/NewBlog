interface Props {
  name: PixelIconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const grid = GRIDS[name];
const cells: { x: number; y: number }[] = [];
grid.forEach((row, y) => {
  for (let x = 0; x < row.length; x++) {
    if (row[x] === '#') cells.push({ x, y });
  }
});
---

<svg
  class:list={['px-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 12 12"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {cells.map((c) => <rect x={c.x} y={c.y} width="1" height="1" fill="currentColor" />)}
</svg>

<style>
  .px-icon {
    display: inline-block;
    vertical-align: -0.15em;
    flex: none;
  }
</style>
