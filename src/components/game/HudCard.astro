---
/**
 * 「玩法解剖室」HUD 槽位卡:存档槽语义(SLOT 编号 + 标题 + 说明),
 * 传入 href 时渲染为链接。样式基座来自 game.css 的 .hud-card。
 */
interface Props {
  slot: string;
  label?: string;
  title: string;
  note?: string;
  meta?: string;
  href?: string;
}

const { slot, label, title, note, meta, href } = Astro.props;
const Tag = (href ? 'a' : 'div') as 'a' | 'div';
---

<Tag class="hud-card slot" href={href}>
  <p class="slot-head">
    <span class="slot-no">{slot}</span>
    {label && <span class="mono-label">{label}</span>}
  </p>
  <h3 class="slot-title">{title}</h3>
  {note && <p class="slot-note">{note}</p>}
  {meta && <p class="slot-meta mono-label">{meta}</p>}
</Tag>

<style>
  .slot {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: clamp(1rem, 2.4vw, 1.4rem);
    text-decoration: none;
    color: inherit;
  }
  a.slot:hover {
    text-decoration: none;
  }
  .slot-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0;
  }
  .slot-no {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--game-coral);
  }
  .slot-title {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: 18.5px;
    color: var(--foreground);
  }
  .slot-note {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--muted-foreground);
  }
  .slot-meta {
    margin: 0.4rem 0 0;
  }
</style>
