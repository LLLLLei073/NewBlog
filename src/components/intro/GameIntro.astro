---
/**
 * 「存档之外」开屏动画:插入记忆卡,发现旧存档。
 * 钴蓝全屏;中央奶油白记忆卡(四个存档格,扫描后 01 选中)、
 * 左侧倾斜记忆卡图形、大标题叠放、分段加载条与 PRESS START。
 * 模板 SSR 输出但 hidden,由 columnIntro 控制器 + gameIntro
 * 时间线决定播放;不播放时移除节点。存档格内容是栏目装饰,
 * 不代表真实平台存档数据。
 */
import PixelIcon from '../game/PixelIcon.astro';
import { COLUMN } from '../../data/game/column.ts';

const SLOT_CELLS = [
  { no: '01', icon: 'gear', label: '持续建造' },
  { no: '02', icon: 'leaf', label: '生存记录' },
  { no: '03', icon: 'chat', label: '系列记录' },
  { no: '04', icon: 'empty', label: 'EMPTY SLOT' },
] as const;
const SEGMENTS = Array.from({ length: 12 }, (_, i) => i);
---

<div
  class="game-intro"
  data-game-intro
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="游戏专栏开屏动画:插入记忆卡,发现旧存档"
>
  {/* 半调网点与像素装饰 */}
  <i class="gi-dots p1 gg-halftone-cream" aria-hidden="true"></i>
  <i class="gi-dots p2 gg-halftone-cream" aria-hidden="true"></i>
  <i class="gi-dots p3 gg-halftone-cream" aria-hidden="true"></i>
  <i class="gi-spark s1" aria-hidden="true">+</i>
  <i class="gi-spark s2" aria-hidden="true">+</i>
  <i class="gi-spark s3" aria-hidden="true">▪</i>
  <i class="gi-spark s4" aria-hidden="true">▪</i>

  {/* 左上:插入提示(装饰) */}
  <div class="gi-notice" data-gi-notice aria-hidden="true">
    <p>»» INSERT MEMORY CARD</p>
    <p>»» DO NOT REMOVE DURING ACCESS</p>
  </div>

  {/* 左侧:倾斜的记忆卡图形(装饰) */}
  <div class="gi-sidecard" data-gi-sidecard aria-hidden="true">
    <div class="gi-sidecard-inner">
      <svg viewBox="0 0 96 72" class="gi-sidecard-art">
        <rect x="6" y="10" width="84" height="52" fill="var(--gg-cream, #f4efd8)" stroke="var(--gg-ink, #151515)" stroke-width="4" />
        <rect x="14" y="18" width="30" height="14" fill="var(--gg-ink, #151515)" />
        <rect x="14" y="40" width="52" height="5" fill="var(--gg-ink, #151515)" />
        <rect x="14" y="49" width="38" height="5" fill="var(--gg-ink, #151515)" />
        <rect x="72" y="18" width="10" height="24" fill="var(--gg-coral, #ff7058)" stroke="var(--gg-ink, #151515)" stroke-width="3" />
      </svg>
      <p class="gi-sidecard-label">MEMORY CARD</p>
      <p class="gi-sidecard-sub">15 BLOCKS</p>
      <i class="gi-sidecard-dots gg-halftone-cream"></i>
    </div>
  </div>

  {/* 中央舞台 */}
  <div class="gi-stage">
    {/* 记忆卡 */}
    <div class="gi-card-wrap" data-gi-cardwrap>
      <i class="gi-card-shadow" data-gi-shadow aria-hidden="true"></i>
      <div class="gi-card" data-gi-card>
        <span class="gi-newgame gg-sticker gg-sticker--coral" data-gi-newgame
          >NEW GAME+</span
        >
        <p class="gi-card-head">MEMORY CARD / SLOT 01</p>
        <div class="gi-slots" data-gi-slotrow>
          <span class="gi-scan" data-gi-scan aria-hidden="true">▶</span>
          {
            SLOT_CELLS.map((cell, i) => (
              <span
                class="gi-slot"
                data-gi-slot={String(i)}
                aria-hidden="true"
              >
                <span class="gi-slot-no">{cell.no}</span>
                <span class="gi-slot-icon">
                  <PixelIcon name={cell.icon} size={22} />
                </span>
                <span class="gi-slot-lb">{cell.label}</span>
              </span>
            ))
          }
        </div>
        <span class="gi-arrow" data-gi-arrow aria-hidden="true">
          <PixelIcon name="play" size={12} />
        </span>
      </div>
    </div>

    {/* 状态文字 */}
    <p class="gi-status" aria-hidden="true">
      <span class="gi-status-text" data-gi-status>&gt; ACCESSING SAVE DATA...</span>
      <i class="gi-status-line" data-gi-status-line></i>
    </p>

    {/* WORLD IN PROGRESS 贴纸 */}
    <span class="gi-wip gg-sticker" data-gi-wip aria-hidden="true">
      {COLUMN.sticker}
    </span>

    {/* 标题(与记忆卡少量重叠) */}
    <div class="gi-title" data-gi-titlewrap aria-hidden="true">
      <p class="gi-cn">
        <span class="cn-line">
          <span class="cn-mask">
            <i class="cn-shadow" data-gi-cnshadow1>存档</i>
            <b class="cn-face" data-gi-cnface1>存档</b>
          </span>
        </span>
        <span class="cn-line l2">
          <span class="cn-mask">
            <i class="cn-shadow" data-gi-cnshadow2>之外</i>
            <b class="cn-face" data-gi-cnface2>之外</b>
          </span>
        </span>
      </p>
      <p class="gi-en" data-gi-en>{COLUMN.en}</p>
      <p class="gi-claim"><span data-gi-claim>{COLUMN.claimFull}</span></p>
    </div>

    {/* 分段加载条 */}
    <div class="gi-loader" data-gi-loader aria-hidden="true">
      <span class="gi-load-label" data-gi-load-label>LOADING SAVE DATA</span>
      <div class="gi-load-bar">
        {
          SEGMENTS.map((i) => (
            <span class="gi-seg">
              <i data-gi-seg={String(i)} />
            </span>
          ))
        }
      </div>
      <span class="gi-load-pct" data-gi-load-pct>0%</span>
    </div>

    {/* PRESS START */}
    <p class="gi-start" data-gi-start aria-hidden="true">
      <span class="gi-start-arrow" style="transform: scaleX(-1)">
        <PixelIcon name="play" size={13} />
      </span>
      PRESS START
      <span class="gi-start-arrow">
        <PixelIcon name="play" size={13} />
      </span>
      <i class="gi-start-line" data-gi-start-line></i>
    </p>
  </div>

  <p class="gi-corner" data-gi-corner aria-hidden="true">
    GOOD GAME.<br />GREAT MEMORIES.
  </p>

  <button type="button" class="gi-skip" data-intro-skip>跳过开屏</button>
</div>

<script>
  import { onPageLoad } from '../../utils/lifecycle';
  import { mountGameIntro, cancelGameIntroForSwap } from './gameIntro';

  onPageLoad(() => {
    mountGameIntro();
  });
  // 快速离开专栏:立即取消动画并清理(html 上的滚动锁定会跨 swap 存留)
  document.addEventListener('astro:before-swap', cancelGameIntroForSwap);
</script>

<style is:global>
  /* 覆盖层由控制器动态搬挂 body 直下并显隐:样式全局收口在 .game-intro */
  .game-intro {
    position: fixed;
    inset: 0;
    height: 100dvh;
    z-index: 300;
    display: grid;
    overflow-y: auto;
    background: #3543c5;
    color: #f4efd8;
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  .game-intro[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .game-intro {
      display: none;
    }
  }

  /* ---- 装饰 ---- */
  .game-intro .gi-dots {
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }
  .game-intro .gi-dots.p1 {
    top: 12%;
    left: 4%;
    width: 120px;
    height: 84px;
  }
  .game-intro .gi-dots.p2 {
    bottom: 18%;
    right: 5%;
    width: 140px;
    height: 96px;
  }
  .game-intro .gi-dots.p3 {
    top: 46%;
    right: 12%;
    width: 80px;
    height: 60px;
    opacity: 0;
  }
  .game-intro .gi-spark {
    position: absolute;
    font-family: var(--g-mono, monospace);
    font-size: 18px;
    color: #e7f05b;
    opacity: 0;
    pointer-events: none;
  }
  .game-intro .gi-spark.s1 {
    top: 22%;
    left: 12%;
  }
  .game-intro .gi-spark.s2 {
    top: 64%;
    left: 6%;
    color: #f4efd8;
  }
  .game-intro .gi-spark.s3 {
    top: 30%;
    right: 9%;
  }
  .game-intro .gi-spark.s4 {
    bottom: 12%;
    left: 30%;
    color: #ff7058;
  }

  /* ---- 左上提示 ---- */
  .game-intro .gi-notice {
    position: absolute;
    top: max(20px, env(safe-area-inset-top));
    left: max(22px, env(safe-area-inset-left));
    display: grid;
    gap: 0.15rem;
    opacity: 0;
  }
  .game-intro .gi-notice p {
    margin: 0;
    font-family: var(--g-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: rgba(244, 239, 216, 0.85);
    line-height: 1.7;
  }

  /* ---- 左侧记忆卡图形 ---- */
  .game-intro .gi-sidecard {
    position: absolute;
    left: max(4%, env(safe-area-inset-left));
    top: 30%;
    opacity: 0;
    pointer-events: none;
  }
  .game-intro .gi-sidecard-inner {
    position: relative;
    width: 150px;
    padding: 1rem 0.9rem;
    background: #151515;
    color: #f4efd8;
    border: 3px solid #151515;
    box-shadow: 6px 6px 0 rgba(21, 21, 21, 0.45);
    transform: rotate(-8deg);
  }
  .game-intro .gi-sidecard-art {
    display: block;
    width: 100%;
    height: auto;
  }
  .game-intro .gi-sidecard-label {
    margin: 0.7rem 0 0;
    font-family: var(--g-cond, sans-serif);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.1em;
  }
  .game-intro .gi-sidecard-sub {
    margin: 0.1rem 0 0;
    font-family: var(--g-mono, monospace);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: #e7f05b;
  }
  .game-intro .gi-sidecard-dots {
    position: absolute;
    right: -26px;
    bottom: -22px;
    width: 64px;
    height: 52px;
  }

  /* ---- 中央舞台 ---- */
  .game-intro .gi-stage {
    position: relative;
    margin-block: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(720px, calc(100vw - 2.2rem));
    margin-inline: auto;
    padding-bottom: 2.4rem;
  }

  /* ---- 记忆卡 ---- */
  .game-intro .gi-card-wrap {
    position: relative;
    width: min(620px, 100%);
  }
  .game-intro .gi-card-shadow {
    position: absolute;
    inset: 12px -10px -12px 12px;
    background: #151515;
    opacity: 0;
  }
  .game-intro .gi-card {
    position: relative;
    background: #f4efd8;
    color: #151515;
    border: 4px solid #151515;
    padding: 0.9rem 1rem 1.1rem;
  }
  .game-intro .gi-card-head {
    display: inline-block;
    margin: 0 0 0.8rem;
    padding: 0.3em 0.9em;
    background: #151515;
    color: #f4efd8;
    font-family: var(--g-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.22em;
    white-space: nowrap;
  }
  .game-intro .gi-newgame {
    position: absolute;
    top: -16px;
    right: -12px;
    transform: rotate(6deg);
    font-size: 14px;
  }
  .game-intro .gi-slots {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .game-intro .gi-slot {
    display: grid;
    justify-items: center;
    gap: 0.28rem;
    padding: 0.6rem 0.3rem 0.55rem;
    border: 2.5px solid #151515;
    background: #f4efd8;
    opacity: 0;
    transition: background-color 0.2s ease;
  }
  .game-intro .gi-slot-no {
    font-family: var(--g-cond, sans-serif);
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.08em;
  }
  .game-intro .gi-slot-icon {
    display: inline-flex;
    color: #151515;
  }
  .game-intro .gi-slot-icon svg {
    transition: transform 0.8s cubic-bezier(0.3, 0, 0.2, 1);
  }
  .game-intro .gi-slot-lb {
    font-family: var(--g-mono, monospace);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #4b4a43;
    white-space: nowrap;
  }
  /* 扫描选中态:01 酸性黄 */
  .game-intro .gi-slot.is-sel {
    background: #e7f05b;
  }
  .game-intro .gi-slot.is-sel .gi-slot-icon svg {
    transform: rotate(120deg);
  }
  .game-intro .gi-scan {
    position: absolute;
    top: 50%;
    left: 0;
    width: 14px;
    height: 14px;
    margin: -18px 0 0 -4px;
    color: #151515;
    font-size: 13px;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
  }
  .game-intro .gi-arrow {
    position: absolute;
    right: -8px;
    bottom: -10px;
    color: #151515;
    opacity: 0;
  }

  /* ---- 状态文字 ---- */
  .game-intro .gi-status {
    display: grid;
    justify-items: start;
    gap: 0.3rem;
    width: min(620px, 100%);
    margin: 0.9rem 0 0;
  }
  .game-intro .gi-status-text {
    font-family: var(--g-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.18em;
    color: #e7f05b;
  }
  .game-intro .gi-status-line {
    width: 220px;
    height: 2px;
    background: #151515;
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ---- WIP 贴纸(悬在记忆卡右上角外,不遮存档格) ---- */
  .game-intro .gi-wip {
    position: absolute;
    top: -2.6rem;
    right: -0.4rem;
    font-size: clamp(12px, 1.6vw, 15px);
    opacity: 0;
    z-index: 3;
  }

  /* ---- 标题 ---- */
  .game-intro .gi-title {
    position: relative;
    z-index: 2;
    margin-top: clamp(-1.8rem, -3vw, -1rem);
    text-align: center;
    pointer-events: none;
  }
  .game-intro .gi-cn {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    font-family: var(--g-disp, sans-serif);
    font-weight: 900;
    font-size: clamp(58px, 12.5vw, 132px);
    line-height: 1.02;
    color: #f4efd8;
  }
  .game-intro .cn-line {
    display: block;
  }
  .game-intro .cn-line.l2 {
    margin-left: clamp(1.4em, 9vw, 2.6em);
    margin-top: -0.05em;
  }
  .game-intro .cn-mask {
    position: relative;
    display: block;
    overflow: hidden;
    padding: 0 0.08em 0.08em 0;
  }
  .game-intro .cn-shadow {
    position: absolute;
    top: 0.055em;
    left: 0.055em;
    font-style: normal;
    color: #151515;
    opacity: 0;
  }
  .game-intro .cn-face {
    position: relative;
    display: block;
    font-weight: 900;
    transform: translateY(112%);
  }
  .game-intro .gi-en {
    margin: 0.7rem 0 0;
    font-family: var(--g-cond, sans-serif);
    font-weight: 800;
    font-size: clamp(19px, 4vw, 40px);
    letter-spacing: 0.1em;
    color: #f4efd8;
    text-shadow: 3px 3px 0 #151515;
    opacity: 0;
  }
  .game-intro .gi-claim {
    margin: 0.8rem 0 0;
  }
  .game-intro .gi-claim span {
    display: inline-block;
    padding: 0.32em 0.95em;
    background: #151515;
    color: #f4efd8;
    font-size: clamp(13px, 2vw, 17px);
    letter-spacing: 0.14em;
    transform: rotate(-0.8deg);
    opacity: 0;
  }

  /* ---- 加载条 ---- */
  .game-intro .gi-loader {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    width: min(620px, 100%);
    margin-top: clamp(1.2rem, 3.5vh, 2rem);
    opacity: 0;
  }
  .game-intro .gi-load-label {
    font-family: var(--g-mono, monospace);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    color: rgba(244, 239, 216, 0.85);
    white-space: nowrap;
  }
  .game-intro .gi-load-bar {
    display: flex;
    gap: 4px;
  }
  .game-intro .gi-seg {
    position: relative;
    flex: 1;
    height: 13px;
    border: 2px solid #151515;
    background: rgba(244, 239, 216, 0.25);
    overflow: hidden;
  }
  .game-intro .gi-seg i {
    position: absolute;
    inset: 0;
    background: #e7f05b;
    transform: scaleX(0);
    transform-origin: left;
  }
  .game-intro .gi-load-pct {
    min-width: 4.2ch;
    text-align: right;
    font-family: var(--g-mono, monospace);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: #f4efd8;
  }

  /* ---- PRESS START ---- */
  .game-intro .gi-start {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    margin: clamp(0.9rem, 2.5vh, 1.5rem) 0 0;
    padding: 0.2em 0.6em 0.45em;
    font-family: var(--g-mono, monospace);
    font-weight: 500;
    font-size: clamp(17px, 2.8vw, 24px);
    letter-spacing: 0.28em;
    color: #e7f05b;
    opacity: 0;
  }
  .game-intro .gi-start-arrow {
    display: inline-flex;
  }
  .game-intro .gi-start-line {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 0;
    height: 2px;
    background: #e7f05b;
    transform: scaleX(0);
  }

  /* ---- 角落寄语 ---- */
  .game-intro .gi-corner {
    position: absolute;
    right: max(22px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    margin: 0;
    text-align: right;
    font-family: var(--g-mono, monospace);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    line-height: 1.8;
    color: rgba(244, 239, 216, 0.75);
    opacity: 0;
  }

  /* ---- 跳过按钮(唯一可聚焦元素) ---- */
  .game-intro .gi-skip {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    right: max(20px, env(safe-area-inset-right));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5em 1.1em;
    border: 2px solid rgba(244, 239, 216, 0.5);
    border-radius: 999px;
    background: rgba(21, 21, 21, 0.35);
    color: #f4efd8;
    font-family: var(--font-sans, sans-serif);
    font-size: 13px;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease;
  }
  .game-intro .gi-skip:hover {
    color: #151515;
    background: #e7f05b;
    border-color: #151515;
  }

  /* ---- 移动端 ---- */
  @media (max-width: 640px) {
    .game-intro .gi-sidecard {
      display: none;
    }
    .game-intro .gi-dots.p3,
    .game-intro .gi-spark.s3 {
      display: none;
    }
    .game-intro .gi-slots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .game-intro .gi-scan {
      display: none;
    }
    .game-intro .gi-wip {
      top: -2.2rem;
      right: 0;
    }
    .game-intro .gi-notice p {
      font-size: 10px;
    }
    .game-intro .gi-title {
      margin-top: -0.4rem;
    }
    .game-intro .gi-status,
    .game-intro .gi-loader {
      width: 100%;
    }
    .game-intro .gi-load-label {
      display: none;
    }
    .game-intro .gi-corner {
      display: none;
    }
  }
</style>
