---
/**
 * 「抽屉杂记」专栏内部导航:右侧符号栏(✦/✎),
 * 悬浮显示具体名称;底部个人标记「F.」(→ /about);移动端收为
 * 顶部一条。
 */
import ColumnRail from '../ColumnRail.astro';

const path = Astro.url.pathname;
const is = {
  home: path === '/others/' || path === '/others',
  notes: path.startsWith('/others/notes'),
};
const items = [
  { href: '/others/', glyph: '✦', label: '首页', active: is.home },
  { href: '/others/notes/', glyph: '✎', label: '全部便签', active: is.notes },
];
---

<ColumnRail
  theme="others"
  railLabel="抽屉杂记导航"
  brand={{ cn: '抽屉杂记', en: 'DRAWER NOTES' }}
  items={items}
>
  <a
    slot="utils"
    class="crail-item crail-mark"
    href="/about/"
    aria-label="关于我"
    data-label="关于我">F.</a
  >
  <a slot="panel-extra" class="crail-panel-link" href="/about/">
    <span class="crail-panel-glyph" aria-hidden="true">F.</span>
    关于我
  </a>
</ColumnRail>
