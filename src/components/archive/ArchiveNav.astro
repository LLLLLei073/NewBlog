---
/**
 * 「耳朵的私人档案」专栏内部导航:右侧符号栏(♪/♫/♬/♩/搜索),
 * 悬浮显示具体名称;底部个人标记「F.」(→ /about);移动端收为
 * 顶部一条。中部竖排 LONG PLAY 呼应唱片档案主题。
 */
import ColumnRail from '../ColumnRail.astro';

const path = Astro.url.pathname;
const is = {
  home: path === '/music/' || path === '/music',
  shelf: path.startsWith('/music/shelf') || path.startsWith('/music/album'),
  scenes: path.startsWith('/music/scenes'),
  notes: path.startsWith('/music/notes'),
};
const items = [
  { href: '/music/', glyph: '♪', label: '首页', active: is.home },
  { href: '/music/shelf/', glyph: '♫', label: '唱片架', active: is.shelf },
  { href: '/music/scenes/', glyph: '♬', label: '场景歌单', active: is.scenes },
  { href: '/music/notes/', glyph: '♩', label: '音乐手记', active: is.notes },
];
---

<ColumnRail
  theme="music"
  railLabel="耳朵的私人档案导航"
  brand={{ cn: '耳朵的私人档案', en: 'PRIVATE ARCHIVE' }}
  items={items}
  search={{ href: '/blog/', label: '搜索文章' }}
>
  <span slot="center">LONG PLAY</span>
  <a
    slot="utils"
    class="crail-item crail-mark"
    href="/about/"
    aria-label="关于我"
    data-label="关于我">F.</a
  >
  <a slot="panel-extra" class="crail-panel-link" href="/about/">
    <span class="crail-panel-glyph" aria-hidden="true">F.</span>
    关于我
  </a>
</ColumnRail>
